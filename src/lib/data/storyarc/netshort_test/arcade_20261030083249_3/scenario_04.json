  "prologue": {
    "korean": [
      "수많은 영수증 종이가 바닥을 쓸며 어두운 환전소 안을 감돈다.",
      "기이한 오락기의 유혹이 자물쇠 박힌 문 너머에서 차갑게 숨을 죽인다.",
      "폭력의 그림자가 다가오는 지하상가 깊은 곳으로 발걸음이 이어진다."
    ]
  },
  "rooms": [
    {
      "id": 1,
      "dialogue": [
        {
          "speaker": "narrator",
          "emotion": "base",
          "content": {
            "korean": "수많은 영수증 종이가 어지럽게 쌓인 지하 환전소다."
          },
          "type": "speech"
        },
        {
          "type": "direction",
          "duration_ms": 500,
          "spot": [
            500,
            700
          ],
          "action": "enter",
          "speaker": "echo"
        },
        {
          "content": {
            "korean": "어서 오십시오. 손님들을 기다리고 있었습니다."
          },
          "type": "speech",
          "speaker": "echo",
          "emotion": "base"
        },
        {
          "type": "speech",
          "content": {
            "korean": "장치를 쓰면 폭력에서 우리 모두 살 수 있다고 들었습니다."
          },
          "emotion": "base",
          "speaker": "echo"
        },
        {
          "type": "speech",
          "content": {
            "korean": "살 길만 있다면..."
          },
          "speaker": "character_1",
          "emotion": "base"
        },
        {
          "type": "speech",
          "content": {
            "korean": "위험을 피하려면 환전소 구석부터 조사해야 한다."
          },
          "speaker": "character_any",
          "emotion": "base"
        }
      ]
    },
    {
      "dialogue": [
        {
          "type": "speech",
          "emotion": "base",
          "speaker": "narrator",
          "content": {
            "korean": "주위의 소란이 잠잠해지고 서늘한 적막이 흘러든다."
          }
        },
        {
          "duration_ms": 500,
          "spot": [
            500,
            700
          ],
          "type": "direction",
          "speaker": "echo",
          "action": "enter"
        },
        {
          "speaker": "echo",
          "emotion": "base",
          "content": {
            "korean": "보시다시피 구석의 오락기 장치는 멀쩡히 작동합니다."
          },
          "type": "speech"
        },
        {
          "speaker": "character_any",
          "emotion": "base",
          "content": {
            "korean": "장치를 작동할 때 치러야 할 대가가 무엇인지 밝혀야 한다."
          },
          "type": "speech"
        },
        {
          "content": {
            "korean": "글쎄요, 대가는 그저 가벼운 오류일 뿐 아니겠습니까?"
          },
          "type": "speech",
          "emotion": "base",
          "speaker": "echo"
        },
        {
          "type": "speech",
          "content": {
            "korean": "가벼운 오류라니."
          },
          "emotion": "base",
          "speaker": "character_2"
        },
        {
          "type": "speech",
          "speaker": "character_any",
          "emotion": "base",
          "content": {
            "korean": "에코 역시 대가의 진실을 전혀 알지 못하고 있다."
          }
        }
      ],
      "id": 3
    },
    {
      "id": 5,
      "dialogue": [
        {
          "type": "speech",
          "speaker": "narrator",
          "emotion": "base",
          "content": {
            "korean": "깊은 밤이 지나가며 환전소 창문에 붉은 글씨가 비친다."
          }
        },
        {
          "emotion": "base",
          "speaker": "character_any",
          "content": {
            "korean": "창문에 붙은 붉은 주의 종이에 문구가 적혀 있다."
          },
          "type": "speech"
        },
        {
          "duration_ms": 500,
          "spot": [
            500,
            700
          ],
          "speaker": "echo",
          "action": "enter",
          "type": "direction"
        },
        {
          "type": "speech",
          "speaker": "echo",
          "emotion": "base",
          "content": {
            "korean": "어디 보자, 창문에 붙은 문구를 읽어보겠습니다."
          }
        },
        {
          "speaker": "echo",
          "emotion": "sad",
          "content": {
            "korean": "잠깐, 이 경고는 조금 이상한데요."
          },
          "type": "speech"
        },
        {
          "speaker": "character_3",
          "emotion": "base",
          "type": "speech",
          "content": {
            "korean": "경고문이라니..."
          }
        },
        {
          "type": "speech",
          "content": {
            "korean": "경고문이 애매하지만 지금은 장치를 믿고 나아갈 수밖에 없다."
          },
          "emotion": "base",
          "speaker": "character_any"
        }
      ]
    },
    {
      "dialogue": [
        {
          "content": {
            "korean": "묵직한 발소리와 함께 어둠 속에서 압박감이 밀려온다."
          },
          "emotion": "base",
          "speaker": "narrator",
          "type": "speech"
        },
        {
          "type": "direction",
          "spot": [
            500,
            200
          ],
          "duration_ms": 500,
          "speaker": "random_boss",
          "action": "enter"
        },
        {
          "speaker": "random_boss",
          "emotion": "angry",
          "content": {
            "korean": "더 이상 도망칠 곳은 없다."
          },
          "type": "speech"
        },
        {
          "duration_ms": 500,
          "speaker": "echo",
          "action": "enter",
          "spot": [
            500,
            700
          ],
          "type": "direction"
        },
        {
          "speaker": "echo",
          "type": "speech",
          "emotion": "sad",
          "content": {
            "korean": "놈이 다가옵니다. 내가 장치를 권했지만 정말 괜찮을지 망설여지는군요."
          }
        },
        {
          "type": "speech",
          "emotion": "angry",
          "speaker": "character_4",
          "content": {
            "korean": "더는 지체할 수 없다!"
          }
        },
        {
          "type": "speech",
          "speaker": "character_any",
          "emotion": "base",
          "content": {
            "korean": "모두를 지키려면 오락기 조종석 앞에서 결단을 내려야 한다."
          }
        }
      ],
      "id": 9
    },
    {
      "id": 15,
      "dialogue": [
        {
          "content": {
            "korean": "환전소 중앙에서 거친 폭력의 기운이 뿜어져 나온다."
          },
          "type": "speech",
          "speaker": "narrator",
          "emotion": "base"
        },
        {
          "speaker": "random_boss",
          "emotion": "angry",
          "content": {
            "korean": "여기 쌓인 장부 종이를 전부 찢어버려라."
          },
          "type": "speech"
        },
        {
          "speaker": "random_boss",
          "emotion": "angry",
          "content": {
            "korean": "너희들의 모든 빚과 주먹을 여기서 청산해주지."
          },
          "type": "speech"
        },
        {
          "emotion": "angry",
          "speaker": "character_1",
          "content": {
            "korean": "헛소리를!"
          },
          "type": "speech"
        },
        {
          "duration_ms": 500,
          "spot": [
            500,
            700
          ],
          "speaker": "echo",
          "action": "enter",
          "type": "direction"
        },
        {
          "speaker": "echo",
          "emotion": "sad",
          "type": "speech",
          "content": {
            "korean": "저자의 무차별 공격이 시작됩니다!"
          }
        },
        {
          "speaker": "character_any",
          "emotion": "base",
          "type": "speech",
          "content": {
            "korean": "모두를 지키기 위해 싸움에서 반드시 승리해야 한다."
          }
        }
      ],
      "win_dialogue": [
        {
          "content": {
            "korean": "오락기 투입구에 구겨진 주차권 뒤에 적힌 임의의 이름을 넣고 스위치를 올린다."
          },
          "speaker": "narrator",
          "emotion": "base",
          "type": "speech"
        },
        {
          "speaker": "character_any",
          "emotion": "base",
          "type": "speech",
          "content": {
            "korean": "모두를 지키기 위해 장치를 가동하여 피해를 막는다."
          }
        },
        {
          "duration_ms": 500,
          "type": "direction",
          "action": "shake",
          "speaker": "narrator"
        },
        {
          "content": {
            "korean": "묵직한 주먹이 스쳐 지나가지만 피한 몸은 상처 하나 없이 멀쩡하다."
          },
          "emotion": "base",
          "speaker": "narrator",
          "type": "speech"
        },
        {
          "type": "speech",
          "emotion": "base",
          "speaker": "narrator",
          "content": {
            "korean": "그러나 멀리 떨어져 있던 맥스의 얼굴에 갑자기 검붉은 멍이 든다."
          }
        },
        {
          "type": "direction",
          "action": "enter",
          "spot": [
            500,
            700
          ],
          "duration_ms": 500,
          "speaker": "echo"
        },
        {
          "emotion": "sad",
          "speaker": "echo",
          "content": {
            "korean": "내가 잘못 생각했습니다, 다 내 탓입니다!"
          },
          "type": "speech"
        },
        {
          "content": {
            "korean": "우리가 맞을 주먹이 무고한 사람에게 넘어간 진실을 확인했다."
          },
          "emotion": "base",
          "speaker": "character_any",
          "type": "speech"
        },
        {
          "content": {
            "korean": "이제 속죄하는 마음으로 끝까지 여러분의 편에 서서 돕겠습니다."
          },
          "emotion": "sad",
          "speaker": "echo",
          "type": "speech"
        }
      ],
      "lose_dialogue": [
        {
          "action": "shake",
          "speaker": "narrator",
          "duration_ms": 500,
          "type": "direction"
        },
        {
          "type": "speech",
          "content": {
            "korean": "연타가 작렬하며 히어로들이 차가운 바닥에 내팽개쳐진다."
          },
          "speaker": "narrator",
          "emotion": "base"
        },
        {
          "type": "speech",
          "content": {
            "korean": "빚을 갚지 못한 자들의 당연한 결말이다."
          },
          "emotion": "angry",
          "speaker": "random_boss"
        },
        {
          "speaker": "echo",
          "action": "enter",
          "spot": [
            500,
            700
          ],
          "type": "direction",
          "duration_ms": 500
        },
        {
          "emotion": "sad",
          "type": "speech",
          "speaker": "echo",
          "content": {
            "korean": "제발 정신 차리십시오, 나도 이제 끝까지 돕겠습니다!"
          }
        },
        {
          "type": "speech",
          "emotion": "angry",
          "speaker": "character_2",
          "content": {
            "korean": "아직 포기할 수는 없다!"
          }
        },
        {
          "type": "speech",
          "speaker": "character_any",
          "emotion": "base",
          "content": {
            "korean": "다시 일어서서 환전소의 폭력에 맞서야 한다."
          }
        }
      ]
    }
  ]
}