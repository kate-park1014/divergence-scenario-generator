        },
        {
          "content": {
            "korean": "쇠사슬에 묶여 강제로 바닥에 넘어진다."
          },
          "speaker": "narrator",
          "emotion": "sad",
          "type": "speech"
        },
        {
          "duration_ms": 500,
          "spot": [
            50,
            20
          ],
          "type": "direction",
          "speaker": "dax",
          "action": "enter"
        },
        {
          "emotion": "angry",
          "type": "speech",
          "speaker": "dax",
          "content": {
            "korean": "붉은 칩을 던져 시선을 끌 테니 어서 일어서라!"
          }
        },
        {
          "type": "speech",
          "speaker": "dax",
          "content": {
            "korean": "장치에 속더라도 끝까지 싸워야 한다!"
          },
          "emotion": "angry"
        }
      ],
