  "rooms": [
    {
      "id": 1,
      "dialogue": [
        {
          "emotion": "base",
          "content": {
            "korean": "손수레 자국이 회장실을 가리키자 히어로들이 CCTV를 확인하러 폐창고 서버실로 향한다."
          },
          "speaker": "narrator",
          "type": "speech"
        },
        {
          "spot": [
            50,
            200
          ],
          "type": "direction",
          "action": "enter",
          "speaker": "dax",
          "duration_ms": 500
        },
        {
          "speaker": "dax",
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "비서님이 알려 주셨어요. 해커 간부님이 어젯밤에 혼자 서버실로 들어갔대요!"
          }
        },
        {
          "emotion": "base",
          "content": {
            "korean": "지난번 꽃집 컨테이너 자국도 그렇고, 이번엔 CCTV 영상부터 확인해 보자."
          },
          "speaker": "character_any",
          "type": "speech"
        },
        {
          "type": "speech",
          "content": {
            "korean": "사람부터 무작정 의심하지 말고 확실한 증거를 잡는 거야!"
          },
          "emotion": "base",
          "speaker": "character_1"
        },
        {
          "speaker": "narrator",
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "닥스와 히어로들이 어두운 폐창고 서버실 입구에 다다른다."
          }
        },
        {
          "emotion": "base",
          "content": {
            "korean": "어젯밤 영상에 결정적인 단서가 있을 테니 어서 가 보자."
          },
          "type": "speech",
          "speaker": "character_any"
        }
      ]
    },
    {
      "id": 3,
      "dialogue": [
        {
          "spot": [
            50,
            200
          ],
          "duration_ms": 500,
          "action": "enter",
          "type": "direction",
          "speaker": "dax"
        },
        {
          "type": "speech",
          "content": {
            "korean": "서버실로 이어지는 긴 복도 천장의 CCTV 카메라 불빛이 하나씩 툭툭 꺼진다."
          },
          "emotion": "base",
          "speaker": "narrator"
        },
        {
          "speaker": "dax",
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "카메라 선이 전부 잘려 있어요. 누군가 일부러 끈 거예요!"
          }
        },
        {
          "speaker": "character_any",
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "우리가 영상을 보러 올 줄 알고 길목을 어둡게 만든 건가?"
          }
        },
        {
          "emotion": "base",
          "content": {
            "korean": "깜깜해서 발밑 전선도 잘 안 보여!"
          },
          "type": "speech",
          "speaker": "character_2"
        },
        {
          "speaker": "narrator",
          "type": "speech",
          "content": {
            "korean": "어두운 복도 끝에서 기계 쿨러 소리만 둔탁하게 울려 퍼진다."
          },
          "emotion": "base"
        },
        {
          "content": {
            "korean": "안에서 무슨 일이 벌어지는 게 틀림없어. 조심해서 나아가자."
          },
          "emotion": "base",
          "type": "speech",
          "speaker": "character_any"
        }
      ]
    },
    {
      "id": 5,
      "dialogue": [
        {
          "action": "enter",
          "type": "direction",
          "spot": [
            50,
            200
          ],
          "duration_ms": 500,
          "speaker": "dax"
        },
        {
          "type": "speech",
          "content": {
            "korean": "서버실 강철문이 안에서 굳게 잠겨 있고, 문틈으로 파란 불빛이 깜빡인다."
          },
          "emotion": "base",
          "speaker": "narrator"
        },
        {
          "speaker": "character_any",
          "type": "speech",
          "content": {
            "korean": "안에서 급하게 키보드를 두드리는 소리가 들리는데?"
          },
          "emotion": "base"
        },
        {
          "speaker": "narrator",
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "문너머 기계에서 삭제 완료라는 안내음이 끊임없이 흘러나온다."
          }
        },
        {
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "그날 밤 영상은 용량이 커서 다 지우려면 한참 걸릴 거예요."
          },
          "speaker": "dax"
        },
        {
          "speaker": "character_3",
          "type": "speech",
          "content": {
            "korean": "다 지워지기 전에 멈춰야 해!"
          },
          "emotion": "base"
        },
        {
          "speaker": "character_any",
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "하지만 강철문이 단단히 잠겨서 당장 뚫기는 어렵겠어."
          }
        }
      ]
    },
    {
      "dialogue": [
        {
          "speaker": "dax",
          "spot": [
            50,
            200
          ],
          "type": "direction",
          "action": "enter",
          "duration_ms": 500
        },
        {
          "speaker": "dax",
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "제가 비밀번호를 아는 당직 경비원님을 찾아올게요! 잠시만 기다려 주세요!"
          }
        },
        {
          "direction": "down",
          "duration_ms": 500,
          "action": "exit",
          "type": "direction",
          "speaker": "dax"
        },
        {
          "type": "speech",
          "speaker": "narrator",
          "content": {
            "korean": "닥스가 어두운 복도 저편으로 황급히 달려간 다."
          },
          "emotion": "base"
        },
        {
          "type": "speech",
          "content": {
            "korean": "닥스가 경비원을 모셔 올 때까지 잠긴 문 앞을 지키자."
          },
          "emotion": "base",
          "speaker": "character_any"
        },
        {
          "emotion": "base",
          "content": {
            "korean": "안에서 삭제음이 계속 들리니까 마음이 급해지네."
          },
          "speaker": "character_1",
          "type": "speech"
        },
        {
          "type": "speech",
          "speaker": "narrator",
          "emotion": "base",
          "content": {
            "korean": "문틈 사이로 차가운 기계음만 끊임없이 맴돈다."
          }
        },
        {
          "type": "speech",
          "speaker": "character_any",
          "emotion": "base",
          "content": {
            "korean": "닥스만 오면 바로 들어가서 삭제를 저지하겠어."
          }
        }
      ],
      "id": 7
    },
    {
      "id": 9,
      "event": "campsite",
      "before_event_dialogue": [
        {
          "duration_ms": 500,
          "speaker": "dax",
          "type": "direction",
          "spot": [
            50,
            200
          ],
          "action": "enter"
        },
        {
          "emotion": "base",
          "content": {
            "korean": "히어로들이 서버실 앞 복도 의자에 앉아 숨을 가다듬는다."
          },
          "type": "speech",
          "speaker": "narrator"
        },
        {
          "type": "speech",
          "content": {
            "korean": "비밀번호 쪽지를 가져왔어요! 하지만 해커 간부님은 불을 끄고 싸우는 버릇이 있어요."
          },
          "emotion": "base",
          "speaker": "dax"
        },
        {
          "speaker": "character_any",
          "type": "speech",
          "content": {
            "korean": "어둠 속 싸움이라면 방심해서는 안 되겠는걸."
          },
          "emotion": "base"
        },
        {
          "emotion": "base",
          "content": {
            "korean": "닥스가 숨을 들이쉬며 비밀번호 쪽지를 꼭 쥔다."
          },
          "type": "speech",
          "speaker": "narrator"
        },
        {
          "speaker": "character_any",
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "그래, 여기서 잠깐 쉬고 들어가자."
          }
        }
      ],
      "dialogue": [
        {
          "speaker": "narrator",
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "숨을 가다듬은 히어로들이 비밀번호를 입력하고 서버실 문을 연다."
          }
        },
        {
          "speaker": "narrator",
          "type": "speech",
          "content": {
            "korean": "모니터마다 지우기 진행 막대가 빠른 속도로 차오르고 있다."
          },
          "emotion": "base"
        },
        {
          "duration_ms": 500,
          "action": "enter",
          "spot": [
            50,
            200
          ],
          "type": "direction",
          "speaker": "random_boss"
        },
        {
          "type": "speech",
          "speaker": "random_boss",
          "emotion": "angry",
          "content": {
            "korean": "이건 절대 못 보여 줘! 이 영상이 퍼지면 내 인생은 그대로 끝이야!"
          }
        },
        {
          "content": {
            "korean": "어젯밤 영상이고 뭐고 전부 싹 지워 버릴 거다!"
          },
          "emotion": "angry",
          "speaker": "random_boss",
          "type": "speech"
        },
        {
          "type": "speech",
          "content": {
            "korean": "백상어파 해커 간부가 모니터를 온몸으로 가로막으며 버틴다."
          },
          "emotion": "base",
          "speaker": "narrator"
        },
        {
          "type": "speech",
          "content": {
            "korean": "대체 뭘 숨기길래 인생이 끝난다는 거지?"
          },
          "emotion": "base",
          "speaker": "character_any"
        },
        {
          "speaker": "character_4",
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "지우기 막대가 벌써 절반 넘게 찼잖아!"
          }
        }
      ]
    },
    {
      "id": 10,
      "win_dialogue": [
        {
          "emotion": "base",
          "content": {
            "korean": "백상어파 해커 간부가 발밑에 엉킨 서버 선에 걸려 쿵 하고 넘어진다."
          },
          "type": "speech",
          "speaker": "narrator"
        },
        {
          "speaker": "narrator",
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "히어로들이 멈춰 선 모니터 화면을 가만히 들여다본다."
          }
        },
        {
          "speaker": "random_boss",
          "type": "speech",
          "emotion": "sad",
          "content": {
            "korean": "회식 날 노래방에서 춤추는 내 영상을 조직원들이 보면 평생 놀림감이 된다고!"
          }
        },
        {
          "type": "speech",
          "speaker": "narrator",
          "content": {
            "korean": "지우려던 것은 기금 영상이 아니라 해커 간부의 노래방 춤 영상이었다."
          },
          "emotion": "base"
        },
        {
          "type": "speech",
          "speaker": "random_boss",
          "emotion": "base",
          "content": {
            "korean": "그날 밤 CCTV 영상을 되살려 줄 테니 이건 꼭 비밀로 해 줘."
          }
        },
        {
          "type": "speech",
          "content": {
            "korean": "되살려 낸 영상 속에는 기금 상자를 든 정장 차림이 찍혀 있지만 얼굴은 우산에 가려져 있다."
          },
          "emotion": "base",
          "speaker": "narrator"
        },
        {
          "speaker": "dax",
          "action": "enter",
          "duration_ms": 500,
          "type": "direction",
          "spot": [
            50,
            200
          ]
        },
        {
          "type": "speech",
          "content": {
            "korean": "얼굴은 가려졌지만 정장에 우산이라니, 이게 세 번째 단서네요!"
          },
          "emotion": "base",
          "speaker": "dax"
        }
      ],
      "dialogue": [
        {
          "type": "speech",
          "speaker": "random_boss",
          "emotion": "angry",
          "content": {
            "korean": "더 이상 가까이 오지 마! 삭제 버튼을 눌러 버릴 테니까!"
          }
        },
        {
          "speaker": "character_any",
          "emotion": "base",
          "content": {
            "korean": "지우기 전에 보겠습니다!"
          },
          "type": "speech"
        },
        {
          "type": "speech",
          "content": {
            "korean": "히어로들과 백상어파 해커 간부가 거대한 서버 대열 사이에서 맞서 싸운다."
          },
          "emotion": "base",
          "speaker": "narrator"
        },
        {
          "speaker": "character_1",
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "삭제 버튼에 손대지 못하게 막아!"
          }
        }
      ],
      "lose_dialogue": [
        {
          "speaker": "narrator",
          "type": "speech",
          "content": {
            "korean": "해커 간부가 서버실 스위치를 내리자 히어로들이 서버 선에 엉켜 바닥에 넘어진다."
          },
          "emotion": "base"
        },
        {
          "duration_ms": 500,
          "speaker": "dax",
          "type": "direction",
          "spot": [
            50,
            200
          ],
          "action": "enter"
        },
        {
          "speaker": "dax",
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "괜찮으세요? 휴대폰 불빛을 켜세요, 지우기 막대가 아직 반이에요!"
          }
        },
        {
          "emotion": "base",
          "content": {
            "korean": "다시 일어나서 지우는 걸 막아내겠어!"
          },
          "type": "speech",
          "speaker": "character_any"
        }
      ]
    }
  ],
  "prologue": {
    "korean": [
      "안개 낀 항구 부두의 금고에서 부두 어르신 기금이 통째로 사라졌다.",
      "조직 내부의 쥐를 찾기 위해 해결사 히어로들이 폐창고 거리로 들어선다.",
      "기금의 행방을 쥔 세 번째 단서를 찾아 어두운 서버실로 향한다."
    ]
  }
}