	"dialogue": [
		{
			"speaker": "yashik_sajang",
			"content": {
				"korean": "아니, 당신들이 그 자기 몫만 챙긴다는 해결사들 아닌가? 왜 남의 장사 앞에서 이렇게 얼쩡거리고 그래?"
			}
		},
		{
			"speaker": "dax",
			"content": {
				"korean": "저희가 뭘 얼쩡거린다고 그래요? 그냥… 잠깐 쉬는 중인데."
			}
		},
		{
			"speaker": "yashik_sajang",
			"content": {
				"korean": "쉬긴 뭘 쉬어, 쯧쯧. 손님 다 떨어지게. 저기 저 박스들 좀 옮겨주면 빨리 좀 가줄랑가?"
			}
		},
		{
			"speaker": "narrator",
			"content": {
				"korean": "야식트럭 사장이 트럭 옆에 쌓인 음료수 상자들을 가리킨다."
			}
		}
	],
	"choices": [
		{
			"text": {
				"korean": "\"돈 주면 옮겨주겠다\"며 상자 값으로 흥정한다."
			},
			"path": "easy",
			"mbti": "EN",
			"flag": "snack_truck_greed",
			"effects": {
				"gold": 100
			},
			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "당신이 상자 하나당 얼마를 요구하자, 사장이 못마땅한 표정으로 지갑을 꺼낸다."
					}
				},
				{
					"speaker": "yashik_sajang",
					"content": {
						"korean": "쯧쯧, 돈만 밝히는 건 여전하구만. 얼른 옮기고 가쇼!"
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "와, 저 아저씨 진짜 돈 줄 거라고는 생각 못 했어요!"
					}
				}
			],
			"risk": {
				"chance": "mid",
				"bad": {
					"effects": {
						"gold": -30
					},
					"reward": [],
					"result": [
						{
							"speaker": "narrator",
							"content": {
								"korean": "당신이 상자 값 흥정을 하려 하자,"
							}
						},
						{
							"speaker": "narrator",
							"content": {
								"korean": "사장이 지갑 대신 손에 들고 있던 야식 전단지를 냅다 당신 얼굴에 던진다."
							}
						},
						{
							"speaker": "yashik_sajang",
							"content": {
								"korean": "이런 날강도 같은 소리 하고 있네! 내가 누군 줄 알고!"
							}
						},
						{
							"speaker": "dax",
							"content": {
								"korean": "아저씨가 갑자기 화를 내시는데요? 전단지가 눈에 들어갔어요!"
							}
						}
					]
				}
			}
		},
		{
			"text": {
				"korean": "\"우리도 할 일이 있다\"며 단호하게 거절한다."
			},
			"path": "hard",
			"mbti": "TJ",
			"flag": "snack_truck_firm",
			"effects": {
				"echo": 10,
				"community": 20
			},
			"reward": [
				"defense_up"
			],
			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "당신의 단호한 태도에 야식트럭 사장이 잠시 멈칫한다."
					}
				},
				{
					"speaker": "yashik_sajang",
					"content": {
						"korean": "흥, 그래봐야 자기 잇속만 챙기겠지. 두고 보쇼!"
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "아저씨가 꿍얼거리면서 장사 준비를 다시 시작했어요."
					}
				}
			],
			"risk": {
				"chance": "high",
				"bad": {
					"effects": {
						"gold": -20
					},
					"reward": [],
					"result": [
						{
							"speaker": "narrator",
							"content": {
								"korean": "당신이 단호하게 거절하자, 야식트럭 사장이 홧김에 트럭에 실린 양파 망을 당신 쪽으로 던진다."
							}
						},
						{
							"speaker": "narrator",
							"content": {
								"korean": "양파가 굴러다니며 발밑을 위협한다."
							}
						},
						{
							"speaker": "yashik_sajang",
							"content": {
								"korean": "어디 두고 보자고! 내 장사를 망치려 들면 가만 안 있을 거여!"
							}
						},
						{
							"speaker": "dax",
							"content": {
								"korean": "양파 때문에 발밑이 미끄러운데요! 아저씨가 계속 우리를 노려봐요!"
							}
						}
					]
				}
			}
		},
		{
			"text": {
				"korean": "\"당신 같은 장사치와는 엮이지 않는다\"며 무시한다."
			},
			"path": "stat",
			"mbti": "SP",
