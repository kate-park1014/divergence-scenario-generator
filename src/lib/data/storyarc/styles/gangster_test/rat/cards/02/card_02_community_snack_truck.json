			],
			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "당신의 변명에 야식트럭 사장이 실망한 표정으로 고개를 젓는다."
					}
				},
				{
					"speaker": "yashik_sajang",
					"content": {
						"korean": "흥, 동네 사람 위한다는 소문도 다 헛소문인가. 바쁘면 나만 바쁜가!"
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "어휴, 아저씨가 계속 우리를 노려보시는데, 혹시 뭐라도 던지실까 봐 겁나네요."
					}
				}
			],
			"risk": {
				"chance": "high",
				"bad": {
					"effects": {
						"gold": -20
					},
					"reward": [],
					"result": [
						{
							"speaker": "narrator",
							"content": {
								"korean": "당신이 바쁘다고 둘러대자, 야식트럭 사장이 \"바쁘면 이거라도 좀 봐주시오!\"라며 트럭 엔진룸을 열어 보인다."
							}
						},
						{
							"speaker": "narrator",
							"content": {
								"korean": "시꺼먼 연기가 뿜어져 나오며 당신의 옷을 더럽힌다."
							}
						},
						{
							"speaker": "yashik_sajang",
							"content": {
								"korean": "아이고, 내 트럭! 이거 고치려면 돈 많이 들 텐데!"
							}
						},
						{
							"speaker": "dax",
							"content": {
								"korean": "연기가 너무 심한데요? 아저씨가 계속 우리를 쳐다봐요!"
							}
						}
					]
				}
			}
		},
		{
			"text": {
				"korean": "\"무슨 문제인지 자세히 말해달라\"며 상황을 파악하려 한다."
