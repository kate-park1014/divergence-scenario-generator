			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "당신이 채소 박스를 능숙하게 옮기자, 사장이 감탄하며 고맙다고 인사한다."
					}
				},
				{
					"speaker": "yashik_sajang",
					"content": {
						"korean": "역시 동네 해결사들은 다르구만! 힘도 좋고 마음씨도 곱고!"
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "아저씨가 기분 좋으셔서 서비스로 만두를 주셨어요!"
					}
				}
			],
			"risk": {
				"chance": "mid",
				"bad": {
					"effects": {
						"gold": -20
					},
					"reward": [],
					"result": [
						{
							"speaker": "narrator",
							"content": {
								"korean": "당신이 채소 박스를 옮기려다 삐끗하며 박스를 놓친다."
							}
						},
						{
							"speaker": "narrator",
							"content": {
								"korean": "박스 안의 배추들이 바닥에 굴러떨어지고, 사장은 한숨을 쉰다."
							}
						},
						{
							"speaker": "yashik_sajang",
							"content": {
								"korean": "아이고, 내 귀한 배추! 이 양반아, 내가 괜히 부탁했구만!"
							}
						},
						{
							"speaker": "dax",
							"content": {
								"korean": "배추가 다 굴러가 버렸어요! 아저씨가 잔소리를 하시는데요?"
							}
						}
					]
				}
			}
		},
		{
			"text": {
				"korean": "\"지금은 바쁘다\"며 급한 일이 있다고 둘러댄다."
