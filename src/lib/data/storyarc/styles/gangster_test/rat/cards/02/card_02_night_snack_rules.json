			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "당신은 사장의 말대로 차를 폐창고 쪽으로 옮겼다."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "야식트럭 사장은 만족한 얼굴로 트럭에서 음료수 한 캔을 던져주었다."
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "사장이 주는 음료수는 고맙지만, 왠지 우리가 부려 먹힌 것 같은데요?"
					}
				}
			],
			"risk": {
				"chance": "mid",
				"bad": {
					"effects": {
						"gold": -50
					},
					"reward": [],
					"result": [
						{
							"speaker": "narrator",
							"content": {
								"korean": "당신이 사장의 요구대로 차를 폐창고 쪽으로 옮기던 중,"
							}
						},
						{
							"speaker": "narrator",
							"content": {
								"korean": "고물 야식트럭 옆에 세워둔 쓰레기통을 건드려 모두 쏟아졌다."
							}
						},
						{
							"speaker": "dax",
							"content": {
								"korean": "악! 쓰레기가 다 쏟아졌어요! 사장님이 화낼 것 같은데요!"
							}
						}
					]
				}
			}
		},
		{
			"text": {
				"korean": "잠복 중인 상황을 설명하며 양해를 구한다"
