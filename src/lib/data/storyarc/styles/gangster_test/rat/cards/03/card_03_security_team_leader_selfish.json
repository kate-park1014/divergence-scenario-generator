			"mbti": "NJ",
			"flag": "question_security",
			"effects": {
				"community": 20,
				"echo": 10
			},
			"reward": [
				"defense_up"
			],
			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "당신이 뇌물을 거절하자 경비 팀장의 얼굴에 당황한 기색이 스친다."
					}
				},
				{
					"speaker": "security_team_leader",
					"content": {
						"korean": "내가… 내가 뭘 숨긴다는 거요? 규정은 규정일 뿐인데…!"
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "팀장님 손에서 땀이 나고 있어요! 뭔가를 숨기는 게 틀림없어요!"
					}
				}
			],
			"risk": {
