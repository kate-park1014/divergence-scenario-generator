	"dialogue": [
		{
			"speaker": "security_youngest",
			"content": {
				"korean": "그... 융통성 있게 일 처리한다는... 해결사 맞으십니까? 소문이 자자하시던데..."
			}
		},
		{
			"speaker": "narrator",
			"content": {
				"korean": "경호팀 막내는 잔뜩 긴장한 얼굴로 금고실 문을 지키고 서 있다."
			}
		},
		{
			"speaker": "security_youngest",
			"content": {
				"korean": "이 문은... 회장님 허락 없이는 누구도 통과할 수 없습니다. 하지만... 그, 혹시..."
			}
		},
		{
			"speaker": "dax",
			"content": {
				"korean": "막내야, 누님이 안에 계신 건 아는데 왜 이래요? 우리가 지금 얼마나 급한 상황인데!"
			}
		}
	],
	"choices": [
		{
			"text": {
				"korean": "경호팀 막내에게 상황의 유연한 대처를 요구하며 길을 비켜 달라고 설득한다."
			},
			"path": "easy",
			"mbti": "EN",
			"flag": "guard_situation_first",
			"effects": {
				"gold": 100
			},
			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "막내는 당신의 말에 혼란스러운 표정으로 문을 열어 준다."
					}
				},
				{
					"speaker": "security_youngest",
					"content": {
						"korean": "이게... 맞는 일일까요? 누님에게는... 제가 잠시 자리를 비웠다고 해주십시오."
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "막내가 저렇게 어리둥절한 표정이라니... 뭔가 숨기는 게 있나 봐요."
					}
				}
			],
			"risk": {
				"chance": "mid",
				"bad": {
					"effects": {
						"gold": -30
					},
					"reward": [],
					"result": [
						{
							"speaker": "narrator",
							"content": {
								"korean": "당신이 막내에게 상황에 맞춰 대처하라고 하자 막내는 더욱 당황한다."
							}
						},
						{
							"speaker": "security_youngest",
							"content": {
								"korean": "잠시만요! 그, 제 임무는... 으악!"
							}
						},
						{
							"speaker": "narrator",
							"content": {
								"korean": "막내는 발을 헛디뎌 넘어지며 들고 있던 무전기를 놓친다."
							}
						},
						{
							"speaker": "narrator",
							"content": {
								"korean": "무전기에서는 지직거리는 소리와 함께 누군가의 짧은 기침 소리가 흘러나온다."
							}
						}
					]
				}
			}
		},
		{
			"text": {
				"korean": "규율을 어기는 것은 결국 모두에게 해가 될 것이라고 막내를 타이른다."
