			],
			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "당신이 화분에 물을 주자, 아재는 한숨을 쉬며 안도한다."
					}
				},
				{
					"speaker": "gang_uncle",
					"content": {
						"korean": "켁, 켁… 고맙네! 덕분에 살았어! 내일은 켁, 켁… 내가 비서님 화분에 물 주는 척 몰래 물 줄게!"
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "아재의 선인장 사랑은 아무도 모르게 지켜줘야죠!"
					}
				}
			],
			"risk": {
				"chance": "mid",
				"bad": {
					"effects": {
