			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "이발사 아재의 비명과 함께 짐짝이 계단 모퉁이로 굴러떨어진다."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "덕분에 길은 시원하게 뚫렸지만, 짐짝에서 샴푸병들이 터져 계단이 미끄러워진다."
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "으악, 미끌미끌해요! 누군가 밟고 넘어지면 어떡하죠?"
					}
				}
			],
			"risk": {
				"chance": "mid",
				"bad": {
					"effects": {
						"gold": -30
					},
					"reward": [],
					"result": [
						{
							"speaker": "narrator",
							"content": {
								"korean": "짐짝을 밀자마자 균형을 잃은 이발사 아재가 짐과 함께 계단을 구른다."
							}
						},
						{
							"speaker": "narrator",
							"content": {
								"korean": "짐짝은 터지고 샴푸 거품이 계단을 뒤덮어 당신의 발까지 젖게 만든다."
							}
						},
						{
							"speaker": "dax",
							"content": {
								"korean": "으악, 아저씨 괜찮으세요? 옷도 다 젖었잖아요!"
