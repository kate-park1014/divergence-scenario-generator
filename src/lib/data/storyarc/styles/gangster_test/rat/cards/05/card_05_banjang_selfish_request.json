			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "반장의 눈이 휘둥그레진다. 잠시 망설이던 반장이 고개를 끄덕인다."
					}
				},
				{
					"speaker": "banjang",
					"content": {
						"korean": "좋아요! 기금 절반! 대신 안에 뭐가 있든 다 가져와야 합니다!"
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "반장님, 저러다 다 같이 큰일 나요!"
					}
				}
			],
			"risk": {
				"chance": "mid",
				"bad": {
					"effects": {
						"gold": -30
					},
					"reward": [],
					"result": [
						{
							"speaker": "narrator",
							"content": {
								"korean": "반장이 당신의 요구에 코웃음을 친다. 갑자기 주머니에서 망가진 손목시계를 꺼낸다."
							}
						},
						{
							"speaker": "banjang",
							"content": {
								"korean": "겨우 이 낡은 시계 하나 찾는데 기금 절반? 당신은 너무 비싸요!"
							}
						},
						{
							"speaker": "dax",
							"content": {
								"korean": "반장님, 지금 저희가 급하다고 막 그러는 거 아니죠?"
							}
						}
					]
				}
			}
		},
		{
			"text": {
				"korean": "비서의 물건은 함부로 탐내지 않는다며 반장의 제안을 단호하게 거절한다."
