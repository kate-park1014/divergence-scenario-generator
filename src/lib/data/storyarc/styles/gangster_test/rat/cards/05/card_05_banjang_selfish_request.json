	"dialogue": [
		{
			"speaker": "narrator",
			"content": {
				"korean": "닥스의 차가 안개 속 부두 도로를 달리다 갑자기 멈춘다."
			}
		},
		{
			"speaker": "narrator",
			"content": {
				"korean": "낡은 작업복을 입은 부두 일꾼 반장이 길을 가로막고 서 있다."
			}
		},
		{
			"speaker": "banjang",
			"content": {
				"korean": "당신이 그, 자기 몫은 칼같이 챙긴다는 해결사죠? 딱 제 일에 맞겠네요."
			}
		},
		{
			"speaker": "banjang",
			"content": {
				"korean": "저기, 회장님 비서님이 요즘 좀 이상해요."
			}
		},
		{
			"speaker": "banjang",
			"content": {
				"korean": "그 양반이 등대에 숨겨둔 게 있는데… 저 혼자서는 도저히 못 들어가겠어서…"
			}
		},
		{
			"speaker": "dax",
			"content": {
				"korean": "쉿! 반장님, 저희가 괜히 그쪽 일에 엮이면 안 돼요!"
			}
		},
		{
			"speaker": "banjang",
			"content": {
				"korean": "닥스, 넌 빠져. 이건 이 해결사한테 어울리는 일이야."
			}
		}
	],
	"choices": [
		{
			"text": {
				"korean": "물건을 찾아주는 대가로 금고에서 사라진 기금의 절반을 요구한다."
			},
			"path": "easy",
			"mbti": "TJ",
			"flag": "banjang_greedy_demand",
			"effects": {
