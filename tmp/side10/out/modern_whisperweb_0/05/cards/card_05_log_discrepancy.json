	"dialogue": [
		{
			"speaker": "narrator",
			"content": {
				"korean": "보안 분석가가 수많은 로그 조각들을 연결하며 고개를 갸웃거린다."
			}
		},
		{
			"speaker": "narrator",
			"content": {
