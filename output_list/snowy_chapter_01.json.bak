							"emotion": "base"
						},
						{
							"content": {
								"korean": "모두 이성을 잃었어!",
								"english": "Everyone's lost their minds!",
								"japanese": "みんな理性を失った！",
								"chinese": "大家失去理智了！",
								"french": "Ils ont tous perdu la raison !",
								"spanish": "¡Todos han perdido la razón!",
								"vietnamese": "Mọi người mất trí rồi!",
								"thai": "ทุกคนเสียสติไปแล้ว!",
								"hindi": "सबने अपना होश खो दिया है!"
							},
							"emotion": "sad",
							"speaker": "finn",
							"type": "speech"
						},
						{
							"type": "speech",
							"speaker": "eira",
							"content": {
								"korean": "넌 여기 남아. 우린 간다. 망설일 시간 없어.",
								"english": "You stay here. We're going. No time to hesitate.",
								"japanese": "お前はここに残れ。我々は行く。ためらう時間はない。",
								"chinese": "你留在这。我们走了。没有时间犹豫。",
								"french": "Reste ici. Nous partons. Pas le temps d'hésiter.",
								"spanish": "Quédate aquí. Nos vamos. No hay tiempo para dudar.",
