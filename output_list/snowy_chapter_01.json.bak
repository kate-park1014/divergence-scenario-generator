								"english": "No… that can't be…",
								"japanese": "まさか…そんなはずはない…",
								"chinese": "不…这不可能…",
								"french": "Non… ce n'est pas possible…",
								"spanish": "No… no puede ser…",
								"vietnamese": "Không… không thể nào…",
								"thai": "ไม่… ไม่มีทางเป็นไปได้…",
								"hindi": "नहीं… ऐसा नहीं हो सकता…"
