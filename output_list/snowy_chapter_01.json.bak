					"win_dialogue": [
						{
							"type": "speech",
							"content": {
								"korean": "윽… 봉인… 풀지 마라… 비르다는… 고통받고 있다… 너희는…!",
								"english": "Ugh... The seal... Don't break it... Virda is... suffering... You...!",
