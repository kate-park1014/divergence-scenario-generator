						{
							"emotion": "sad",
							"speaker": "character_any",
							"type": "speech",
							"content": {
								"korean": "…비르다…",
								"english": "...Virda...",
								"japanese": "「…ビルダ…」",
								"chinese": "…维尔达…",
								"french": "...Virda...",
