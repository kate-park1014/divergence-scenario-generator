			"rooms": [
				{
					"id": 1,
					"dialogue": [
						{
							"speaker": "narrator",
							"type": "speech",
							"content": {
								"korean": "얼어붙은 대지 한가운데, 거대한 얼음 비석이 솟아 있었다.",
								"english": "In the heart of the frozen land, a colossal ice monument towered.",
								"japanese": "凍てついた大地の中央に、巨大な氷の石碑がそびえ立っていた。",
								"chinese": "在冰封大地的中央，一座巨大的冰碑赫然耸立。",
								"french": "Au cœur de la terre gelée, un colossal monolithe de glace s'élevait.",
								"spanish": "En el corazón de la tierra helada, un colosal monumento de hielo se alzaba.",
								"vietnamese": "Giữa vùng đất băng giá, một bia đá băng khổng lồ sừng sững.",
								"thai": "ใจกลางดินแดนที่เยือกแข็ง อนุสาวรีย์น้ำแข็งขนาดมหึมาตั้งตระหง่าน",
								"hindi": "जमी हुई भूमि के केंद्र में, एक विशाल बर्फीला स्मारक खड़ा था।"
							},
							"emotion": "base"
						},
						{
							"emotion": "base",
							"speaker": "narrator",
							"type": "speech",
							"content": {
								"korean": "비석의 표면에는 푸른 오팔빛과 금빛 룬 문자가 끊임없이 흘렀다.",
								"english": "On its surface, cerulean opal light and golden runes flowed ceaselessly.",
								"japanese": "石碑の表面には、青いオパール色の光と金色のルーン文字が絶え間なく流れていた。",
								"chinese": "碑石表面，湛蓝的欧泊光芒与金色符文川流不息。",
								"french": "À sa surface, une lumière d'opale céruléenne et des runes dorées coulaient sans cesse.",
								"spanish": "En su superficie, una luz de ópalo cerúleo y runas doradas fluían sin cesar.",
								"vietnamese": "Trên bề mặt bia đá, ánh sáng opal xanh lam và chữ rune vàng liên tục chảy.",
								"thai": "บนพื้นผิวของมัน แสงโอปอลสีครามและอักษรรูนสีทองไหลวนไม่หยุดหย่อน",
								"hindi": "इसकी सतह पर, नीली ओपल की रोशनी और सुनहरे रूण अक्षर लगातार बह रहे थे।"
							}
						},
						{
							"emotion": "happy",
							"speaker": "character_any",
							"type": "speech",
							"content": {
								"korean": "…이게 비르다인가? 믿을 수 없는 광경이야.",
								"english": "…Is this Virda? An unbelievable sight.",
								"japanese": "…これがビルダか？信じられない光景だ。",
								"chinese": "……这就是维尔达吗？真是令人难以置信的景象。",
								"french": "…Est-ce Virda ? Une vue incroyable.",
								"spanish": "…¿Es esto Virda? Una vista increíble.",
								"vietnamese": "…Đây là Virda sao? Một cảnh tượng không thể tin được.",
								"thai": "…นี่คือวิรดาหรือ? ภาพที่เหลือเชื่อจริงๆ",
								"hindi": "…क्या यह विरदा है? एक अविश्वसनीय दृश्य।"
							}
						},
						{
							"spot": [
								4,
								2
							],
							"duration_ms": 500,
							"action": "enter",
							"speaker": "anuk",
							"type": "direction"
						},
						{
							"content": {
								"korean": "함부로 다가서지 마라. 고대의 경고가 서려 있는 곳이다.",
								"english": "Do not approach carelessly. Ancient warnings reside here.",
								"japanese": "むやみに近づくな。古の警告が宿る場所だ。",
								"chinese": "勿要贸然靠近。此地蕴藏着古老的警告。",
								"french": "N'approchez pas imprudemment. Des avertissements anciens y résident.",
								"spanish": "No te acerques imprudentemente. Aquí residen advertencias ancestrales.",
								"vietnamese": "Đừng lại gần một cách thiếu thận trọng. Nơi đây ẩn chứa những lời cảnh báo cổ xưa.",
								"thai": "อย่าเข้าใกล้โดยประมาท ที่นี่มีคำเตือนโบราณสถิตอยู่",
								"hindi": "लापरवाही से पास मत आना। यहाँ प्राचीन चेतावनियाँ निहित हैं।"
							},
							"speaker": "anuk",
							"type": "speech",
							"emotion": "base"
						},
						{
							"speaker": "character_any",
							"type": "speech",
							"content": {
								"korean": "경고? 이런 아름다움 속에 뭐가 있다는 거지?",
								"english": "Warnings? What could be amidst such beauty?",
								"japanese": "警告だと？こんな美しさの中に何があるというのか？",
								"chinese": "警告？如此美景中能有什么？",
								"french": "Avertissements ? Qu'y a-t-il au milieu d'une telle beauté ?",
								"spanish": "¿Advertencias? ¿Qué podría haber en medio de tanta belleza?",
								"vietnamese": "Cảnh báo? Có gì trong vẻ đẹp như thế này chứ?",
								"thai": "คำเตือนรึ? ท่ามกลางความงามเช่นนี้จะมีอะไรได้",
								"hindi": "चेतावनियाँ? ऐसी सुंदरता के बीच क्या हो सकता है?"
							},
							"emotion": "base"
						},
						{
							"action": "shake",
							"duration_ms": 600,
							"speaker": "narrator",
							"type": "direction"
						},
						{
							"type": "speech",
							"speaker": "narrator",
							"content": {
								"korean": "설명할 수 없는 한기와 거부의 파동이 탐험대를 밀쳐냈다.",
								"english": "An inexplicable chill and waves of rejection pushed the expedition back.",
								"japanese": "説明しがたい冷気と拒絶の波動が探検隊を押し戻した。",
								"chinese": "一股难以名状的寒意和排斥的波动将探险队推开。",
								"french": "Un froid inexplicable et des ondes de rejet repoussèrent l'expédition.",
								"spanish": "Un frío inexplicable y ondas de rechazo empujaron a la expedición hacia atrás.",
								"vietnamese": "Một luồng khí lạnh không thể giải thích và những làn sóng từ chối đẩy đoàn thám hiểm lùi lại.",
								"thai": "ความเย็นชาที่อธิบายไม่ได้และคลื่นแห่งการปฏิเสธได้ผลักคณะสำรวจกลับไป",
								"hindi": "एक अकथनीय ठंडक और अस्वीकृति की लहरों ने अभियान दल को पीछे धकेल दिया।"
							},
							"emotion": "base"
						},
						{
							"type": "speech",
							"speaker": "anuk",
							"content": {
								"korean": "…봐라. 비르다는 침입자를 원치 않는다.",
								"english": "...Behold. Virda desires no intruders.",
								"japanese": "「…見よ。ビルダは侵入者を望まぬ。」",
								"chinese": "“……看吧。维尔达不欢迎入侵者。”",
								"french": "...Vois. Virda ne désire aucun intrus.",
								"spanish": "...Mira. Virda no desea intrusos.",
								"vietnamese": "...Nhìn kìa. Virda không muốn kẻ xâm nhập.",
								"thai": "...ดูสิ. เวียร์ด้าไม่ต้องการผู้บุกรุก",
								"hindi": "...देखो। विरदा घुसपैठियों को नहीं चाहती।"
							},
							"emotion": "sad"
						},
						{
							"emotion": "angry",
							"content": {
								"korean": "다가서는 자, 사라져라.",
								"english": "Approachers, begone.",
								"japanese": "「近づく者、消え去れ。」",
								"chinese": "“靠近者，消失吧。”",
								"french": "Ceux qui s'approchent, disparaissent.",
								"spanish": "Quienes se acerquen, desaparezcan.",
								"vietnamese": "Kẻ nào lại gần, hãy biến mất.",
								"thai": "ผู้ที่เข้ามาใกล้ จงหายไป",
								"hindi": "जो करीब आएँ, वे गायब हो जाएँ।"
							},
							"speaker": "random_boss",
							"type": "speech"
						},
						{
							"speaker": "character_any",
							"type": "speech",
							"content": {
								"korean": "첫 번째 방어 시스템인가!",
								"english": "The first defense system, then!",
								"japanese": "「最初の防衛システムか！」",
								"chinese": "“是第一个防御系统吗！”",
								"french": "Le premier système de défense, alors !",
								"spanish": "¡¿El primer sistema de defensa?!",
								"vietnamese": "Hệ thống phòng thủ đầu tiên ư!",
								"thai": "ระบบป้องกันแรกหรือนี่!",
								"hindi": "पहला रक्षा प्रणाली है!"
							},
							"emotion": "angry"
						}
					]
				},
				{
					"id": 3,
					"dialogue": [
						{
							"duration_ms": 500,
							"spot": [
								3,
								2
							],
							"type": "direction",
							"speaker": "anuk",
							"action": "enter"
						},
						{
							"emotion": "base",
							"speaker": "anuk",
							"type": "speech",
							"content": {
								"korean": "저것은… 부러진 지팡이의 룬 문양과 같군.",
								"english": "That... it's like the rune on the broken staff.",
								"japanese": "「あれは…折れた杖のルーンの紋様と同じだ。」",
								"chinese": "“那是……和那根断裂的法杖上的符文图案一样。”",
								"french": "C'est... comme la rune sur le bâton brisé.",
								"spanish": "Eso... es como la runa del bastón roto.",
								"vietnamese": "Đó... giống với ký hiệu rune trên cây trượng bị gãy.",
								"thai": "นั่น...เหมือนรูนบนไม้เท้าที่หักเลย",
								"hindi": "वह... टूटी हुई छड़ी के रूण प्रतीक जैसा है।"
							}
						},
						{
							"content": {
								"korean": "그게 뭔데?",
								"english": "What is it?",
								"japanese": "「それは何だ？」",
								"chinese": "“那是什么？”",
								"french": "Qu'est-ce que c'est ?",
								"spanish": "¿Qué es eso?",
								"vietnamese": "Đó là gì?",
								"thai": "นั่นคืออะไร?",
								"hindi": "वह क्या है?"
							},
							"type": "speech",
							"speaker": "character_any",
							"emotion": "base"
						},
						{
							"emotion": "sad",
							"speaker": "anuk",
							"type": "speech",
							"content": {
								"korean": "고대의 기록에 따르면, '봉인'을 의미하는 룬이다.",
								"english": "According to ancient records, it's a rune meaning 'seal'.",
								"japanese": "「古の記録によると、『封印』を意味するルーンだ。」",
								"chinese": "“根据古老记载，这是一个意味着‘封印’的符文。”",
								"french": "Selon les anciens registres, c'est une rune signifiant 'sceau'.",
								"spanish": "Según los registros antiguos, es una runa que significa 'sello'.",
								"vietnamese": "Theo ghi chép cổ đại, đó là một ký hiệu rune có nghĩa là 'phong ấn'.",
								"thai": "ตามบันทึกโบราณ มันคือรูนที่หมายถึง 'การผนึก'",
								"hindi": "प्राचीन अभिलेखों के अनुसार, इसका अर्थ 'मुहर' है।"
							}
						},
						{
							"content": {
								"korean": "봉인? 비르다가 무언가를 가두고 있다는 건가?",
								"english": "Seal? Virda's imprisoning something?",
								"japanese": "「封印？ビルダが何かを閉じ込めているのか？」",
								"chinese": "“封印？维尔达在囚禁着什么吗？”",
								"french": "Sceau ? Virda retient-elle quelque chose prisonnier ?",
								"spanish": "¿Sello? ¿Está Virda encerrando algo?",
								"vietnamese": "Phong ấn? Virda đang giam giữ thứ gì đó sao?",
								"thai": "ผนึก? เวียร์ด้ากำลังกักขังอะไรบางอย่างอยู่หรือ?",
								"hindi": "मुहर? क्या विरदा कुछ कैद कर रही है?"
							},
							"speaker": "character_any",
							"type": "speech",
							"emotion": "base"
						},
						{
							"emotion": "sad",
							"type": "speech",
							"speaker": "anuk",
							"content": {
								"korean": "비르다는… 위험한 존재를 속박하고 있다는 단서일 수도 있다.",
								"english": "It could be a hint that Virda... binds a dangerous entity.",
								"japanese": "「ビルダは…危険な存在を拘束しているという手がかりかもしれない。」",
								"chinese": "“这可能是维尔达……正在束缚着某种危险存在的线索。”",
								"french": "Ce pourrait être un indice que Virda... retient une entité dangereuse.",
								"spanish": "Podría ser una pista de que Virda... está atando algo peligroso.",
								"vietnamese": "Đó có thể là một manh mối rằng Virda... đang kiềm chế một thứ gì đó nguy hiểm.",
								"thai": "มันอาจเป็นเบาะแสว่าเวียร์ด้า...กำลังกักขังสิ่งอันตรายอยู่",
								"hindi": "यह इस बात का सुराग हो सकता है कि विरदा... किसी खतरनाक चीज़ को रोके हुए है।"
							}
						}
					]
				},
				{
					"id": 5,
					"dialogue": [
						{
							"spot": [
								2,
								2
							],
							"duration_ms": 500,
							"action": "enter",
							"type": "direction",
							"speaker": "anuk"
						},
						{
							"content": {
								"korean": "비르다의 얼음을 방해하는 것은…",
								"english": "To disturb Virda's ice is...",
								"japanese": "「ビルダの氷を邪魔することは…」",
								"chinese": "“打扰维尔达的冰……是”",
								"french": "Perturber la glace de Virda, c'est...",
								"spanish": "Interrumpir el hielo de Virda es...",
								"vietnamese": "Phá hoại băng của Virda là...",
								"thai": "การรบกวนน้ำแข็งของเวียร์ด้าคือ...",
								"hindi": "विरदा की बर्फ को बाधित करना..."
							},
							"speaker": "anuk",
							"type": "speech",
							"emotion": "base"
						},
						{
							"emotion": "sad",
							"content": {
								"korean": "맹세를 어기는 것과 같다. 큰 대가를 치를 것이다.",
								"english": "Like breaking an oath. A heavy price will be paid.",
								"japanese": "「誓いを破るに等しい。大きな代償を払うことになるだろう。」",
								"chinese": "“如同违背誓言。将付出巨大的代价。”",
								"french": "C'est comme briser un serment. Un lourd tribut sera payé.",
								"spanish": "Es como romper un juramento. Se pagará un alto precio.",
								"vietnamese": "Giống như phá vỡ một lời thề. Sẽ phải trả giá đắt.",
								"thai": "เหมือนกับการผิดคำสาบาน จะต้องจ่ายราคาแพง",
								"hindi": "शपथ तोड़ने जैसा है। भारी कीमत चुकानी पड़ेगी।"
							},
							"type": "speech",
							"speaker": "anuk"
						},
						{
							"emotion": "base",
							"type": "speech",
							"speaker": "character_any",
							"content": {
								"korean": "우린 진실을 찾으려는 것뿐이야.",
								"english": "We're just seeking the truth.",
								"japanese": "私たちはただ真実を求めているだけだ。",
								"chinese": "我们只是在寻求真相。",
								"french": "Nous ne faisons que chercher la vérité.",
								"spanish": "Solo buscamos la verdad.",
								"vietnamese": "Chúng tôi chỉ đang tìm kiếm sự thật.",
								"thai": "เราแค่กำลังตามหาความจริง",
								"hindi": "हम तो बस सच की तलाश में हैं।"
							}
						},
						{
							"emotion": "angry",
							"content": {
								"korean": "모든 진실이 해방되어야 하는 것은 아니다.",
								"english": "Not all truths should be unleashed.",
								"japanese": "全ての真実が解き放たれるべきではない。",
								"chinese": "并非所有真相都应被揭露。",
								"french": "Toutes les vérités ne doivent pas être libérées.",
								"spanish": "No todas las verdades deben ser reveladas.",
								"vietnamese": "Không phải mọi sự thật đều nên được giải phóng.",
