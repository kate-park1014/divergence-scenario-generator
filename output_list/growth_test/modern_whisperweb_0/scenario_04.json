  "rooms": [
    {
      "dialogue": [
        {
          "speaker": "narrator",
          "content": {
            "korean": "뒷골목 은신처, 과거 데이터 관리자 카이가 익명 게시판 협박에 시달리고 있다."
          },
          "type": "speech"
        },
        {
          "type": "direction",
          "duration_ms": 500,
          "action": "enter",
          "speaker": "kai",
          "spot": [
            50,
            10
          ]
        },
        {
          "emotion": "sad",
          "content": {
            "korean": "익명 게시판에 제 정보가… 계속 유출되고 있습니다."
          },
          "type": "speech",
          "speaker": "kai"
        },
        {
          "speaker": "kai",
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "협박범의 정보를 폭로하라는 메시지가 계속 뜨는데… 너무 수상해요."
          }
        },
        {
          "type": "speech",
          "speaker": "character_any",
          "emotion": "base",
          "content": {
            "korean": "익명 게시판의 조언, 과연 믿을 수 있을까요?"
          }
        },
        {
          "speaker": "character_any",
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "지난번과 비슷한 패턴의 조언은 오히려 상황을 악화시켰던 경험이 있습니다."
          }
        },
        {
          "speaker": "kai",
          "type": "speech",
          "emotion": "sad",
          "content": {
            "korean": "하지만 지금 당장 제 생명이 위협받고 있어요. 시간이 없습니다!"
          }
        },
        {
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "메시지가 의심스럽지만, 카이 씨의 안전이 우선입니다."
          },
          "speaker": "character_any"
        },
        {
          "speaker": "character_any",
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "다른 방법이 없으니, 협박범의 정보를 폭로해야겠어요."
          }
        },
        {
          "content": {
            "korean": "주인공은 협박범의 정보를 폭로했다."
          },
          "type": "speech",
          "speaker": "narrator"
        }
      ],
      "id": 1
    },
    {
      "dialogue": [
        {
          "speaker": "narrator",
          "type": "speech",
          "content": {
            "korean": "협박은 사라졌지만, 어딘가 불안한 기운이 감돌고 있다."
          }
        },
        {
          "speaker": "random_boss",
          "type": "direction",
          "duration_ms": 500,
          "action": "enter",
          "spot": [
            50,
            10
          ]
        },
        {
          "speaker": "random_boss",
          "emotion": "base",
          "content": {
            "korean": "모든 문제는 해결됐으니, 이제 더 파고들 필요는 없습니다."
          },
          "type": "speech"
        },
        {
          "speaker": "character_any",
          "emotion": "base",
          "content": {
            "korean": "해결됐다뇨? 당신은 대체 누구고, 왜 저희를 막는 거죠?"
          },
          "type": "speech"
        },
        {
          "emotion": "base",
          "content": {
            "korean": "궁금해할 시간에 다른 일을 찾으시는 게 좋을 겁니다."
          },
          "type": "speech",
          "speaker": "random_boss"
        },
        {
          "speaker": "character_any",
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "폭로된 정보에서 네온빛 잔상과 유사한 데이터 서명을 발견했습니다."
          }
        },
        {
          "emotion": "base",
          "content": {
            "korean": "이건 단순한 협박 사건이 아닌 것 같아요. 더 조사해야 합니다."
          },
          "type": "speech",
          "speaker": "character_any"
        },
        {
          "speaker": "random_boss",
          "type": "speech",
          "emotion": "angry",
          "content": {
            "korean": "쓸데없는 호기심은 위험을 부를 뿐. 더 이상의 간섭은 용납하지 않습니다."
          }
        },
        {
          "emotion": "base",
          "content": {
            "korean": "그럼에도 불구하고, 저희는 진실을 알아내야만 합니다."
          },
          "type": "speech",
          "speaker": "character_any"
        }
      ],
      "id": 3
    },
    {
      "dialogue": [
        {
          "type": "speech",
          "content": {
            "korean": "카이의 기억이 왜곡되기 시작했다. 그는 자신의 과거를 혼란스러워한다."
          },
          "speaker": "narrator"
        },
        {
          "duration_ms": 500,
          "spot": [
            50,
            10
          ],
          "speaker": "kai",
          "action": "enter",
          "type": "direction"
        },
        {
          "type": "speech",
          "emotion": "sad",
          "content": {
            "korean": "제가 언제 이런 일을… 제가 이런 사람이었나요?"
          },
          "speaker": "kai"
        },
        {
          "speaker": "character_any",
          "emotion": "sad",
          "content": {
            "korean": "카이 씨의 기억이 왜곡되고 있습니다. 폭로의 부작용이군요."
          },
          "type": "speech"
        },
        {
          "speaker": "character_any",
          "type": "speech",
          "emotion": "sad",
          "content": {
            "korean": "그 익명 게시판의 조언이 결국 함정이었어요. 겉으로만 안전했을 뿐…."
          }
        },
        {
          "speaker": "character_any",
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "카이 씨의 혼란스러운 기억을 바로잡을 방법을 찾아야 합니다."
          }
        },
        {
          "speaker": "kai",
          "emotion": "sad",
          "content": {
            "korean": "저는… 저는 누구죠? 여기가 어디죠?"
          },
          "type": "speech"
        }
      ],
      "id": 5
    },
    {
      "id": 9,
      "dialogue": [
        {
          "type": "speech",
          "content": {
            "korean": "파티는 카이의 왜곡된 기억을 복구하기 위해 노력하고 있다."
          },
          "speaker": "narrator"
        },
        {
          "speaker": "kai",
          "type": "direction",
          "duration_ms": 500,
          "action": "enter",
          "spot": [
            50,
            10
          ]
        },
        {
          "emotion": "base",
          "content": {
            "korean": "카이 씨의 기억 조각들을 모으고 있어요. 이대로는 안 됩니다."
          },
          "type": "speech",
          "speaker": "character_any"
        },
        {
          "type": "speech",
          "speaker": "character_any",
          "emotion": "base",
          "content": {
            "korean": "데이터 서명이 네온빛 잔상과 연결되어 있다는 사실을 기억해야 해요."
          }
        },
        {
          "type": "speech",
          "emotion": "sad",
          "content": {
            "korean": "제 과거에… 다른 일이 있었던 것 같은데…"
          },
          "speaker": "kai"
        },
        {
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "이 왜곡된 기억들을 분석해서 공통점을 찾아봐야겠어요."
          },
          "speaker": "character_any"
        },
        {
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "이 현상의 근원을 파악해야만 카이 씨를 온전히 도울 수 있을 겁니다."
          },
          "speaker": "character_any"
        }
      ]
    },
    {
      "win_dialogue": [
        {
          "emotion": "sad",
          "content": {
            "korean": "해냈지만, 카이 씨의 기억은 여전히 뒤죽박죽입니다."
          },
          "type": "speech",
          "speaker": "character_any"
        },
        {
          "speaker": "kai",
          "spot": [
            50,
            10
          ],
          "duration_ms": 500,
          "type": "direction",
          "action": "enter"
        },
        {
          "emotion": "sad",
          "content": {
            "korean": "제가… 누구였는지… 도무지 기억이 나질 않아요."
          },
          "type": "speech",
          "speaker": "kai"
        },
        {
          "emotion": "sad",
          "content": {
            "korean": "익명 게시판의 말이 함정이었군요. 당장 도움이 되는 것처럼 보였지만…."
          },
          "type": "speech",
          "speaker": "character_any"
        },
        {
          "type": "speech",
          "speaker": "character_any",
          "emotion": "base",
          "content": {
            "korean": "우리가 폭로한 정보가 네온빛 잔상에 의해 조작되어 카이 씨의 기억을 왜곡시켰습니다."
          }
        },
        {
          "type": "speech",
          "speaker": "character_any",
          "emotion": "base",
          "content": {
            "korean": "네온빛 잔상이 기억을 조작하는 방식을 파악하고, 그 연결을 끊어야 합니다."
          }
        }
      ],
      "lose_dialogue": [
        {
          "speaker": "random_boss",
          "type": "speech",
          "emotion": "base",
          "content": {
            "korean": "결국 여기까지입니다. 더 이상의 진실은 없습니다."
          }
        },
        {
          "speaker": "character_any",
          "emotion": "sad",
          "content": {
            "korean": "이대로… 물러설 수는 없어."
          },
          "type": "speech"
        }
      ],
      "dialogue": [
        {
          "content": {
            "korean": "진실을 찾아 나서자, 수상한 중개인이 다시 앞길을 막아선다."
          },
          "type": "speech",
          "speaker": "narrator"
        },
        {
          "emotion": "angry",
          "content": {
            "korean": "더 이상은 한 발짝도 움직일 수 없습니다. 이곳에서 멈추세요."
          },
          "type": "speech",
          "speaker": "random_boss"
        },
        {
          "speaker": "character_any",
          "type": "speech",
          "emotion": "sad",
          "content": {
            "korean": "멈출 수 없어요. 저희의 행동으로 카이 씨의 기억이 망가졌습니다."
          }
        },
        {
          "emotion": "base",
          "content": {
            "korean": "모든 오해는 풀렸습니다. 과거에 얽매이지 마십시오."
          },
          "speaker": "random_boss",
          "type": "speech"
        },
        {
          "speaker": "character_any",
          "type": "speech",
          "emotion": "angry",
          "content": {
            "korean": "카이 씨의 고통을 외면할 순 없습니다. 당신의 방해는 통하지 않아요."
          }
        },
        {
          "type": "speech",
          "speaker": "random_boss",
          "emotion": "angry",
          "content": {
            "korean": "기어이 여기까지 왔군요. 그렇다면… 직접 막아서는 수밖에."
          }
        }
      ],
      "id": 15
    }
  ],
  "prologue": {
    "korean": [
      "네온 불빛이 번쩍이는 뒷골목 은신처.",
      "수많은 네온빛 잔상들이 도시의 기억을 끊임없이 중계한다.",
      "과거 데이터 관리자 카이는 익명 게시판 협박에 시달리고 있었다."
    ]
  }
}