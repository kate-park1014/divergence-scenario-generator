  "rooms": [
    {
      "id": 1,
      "dialogue": [
        {
          "type": "speech",
          "speaker": "narrator",
          "content": {
            "korean": "네온 골목길은 더욱 깊은 어둠에 잠식되어 갔다."
          }
        },
        {
          "speaker": "character_any",
          "content": {
            "korean": "점점 더 많은 것들이 사라지고 있어. 이대로는 안 돼."
          },
          "emotion": "sad",
          "type": "speech"
        },
        {
          "type": "speech",
          "emotion": "sad",
          "speaker": "character_1",
          "content": {
            "korean": "이 감각... 너무 흐릿해."
          }
        },
        {
          "emotion": "base",
          "type": "speech",
          "speaker": "character_any",
          "content": {
            "korean": "우리가 가야 할 길은 정말 이 길이 맞을까?"
          }
        }
      ]
    },
    {
      "id": 3,
      "dialogue": [
        {
          "speaker": "bex",
          "duration_ms": 500,
          "type": "direction",
          "spot": [
            5,
            1
          ],
          "action": "enter"
        },
        {
          "speaker": "bex",
          "content": {
            "korean": "메멘토의 속임수에 넘어가지 마! 단절은 고통의 끝이 아니야!"
          },
          "emotion": "angry",
          "type": "speech"
        },
        {
          "type": "speech",
          "speaker": "character_any",
          "content": {
            "korean": "그렇다면, 우리가 무엇을 해야 한다는 말인가?"
          },
          "emotion": "base"
        },
        {
          "type": "speech",
          "speaker": "narrator",
          "content": {
            "korean": "오팔빛 빛의 잔향이 그들의 판단을 흐리게 만들려 했다."
          }
        },
        {
          "emotion": "base",
          "type": "speech",
          "speaker": "random_boss",
          "content": {
            "korean": "모든 고통을 끝내려면, 그저 끊어내는 것만이 해답이다!"
          }
        },
        {
          "type": "speech",
          "emotion": "angry",
          "speaker": "character_any",
          "content": {
            "korean": "아니, 그건 거짓말이야! 더 큰 고통을 가져올 뿐이다!"
          }
        }
      ]
    },
    {
      "id": 5,
      "dialogue": [
        {
          "action": "enter",
          "type": "direction",
          "speaker": "echo",
          "spot": [
            5,
            1
          ],
          "duration_ms": 500
        },
        {
          "speaker": "echo",
          "content": {
            "korean": "기억은 사라지는 것이 아니야. 실이 끊어지면 소중한 연결만 사라질 뿐이다."
          },
          "type": "speech",
          "emotion": "base"
        },
        {
          "emotion": "base",
          "speaker": "character_any",
          "content": {
            "korean": "그렇다면, 우리가 계속해서 끊어낸 것은... 잘못된 길이었어."
          },
          "type": "speech"
        },
        {
          "emotion": "sad",
          "type": "speech",
          "speaker": "character_2",
          "content": {
            "korean": "이제야 알 것 같아."
          }
        },
        {
          "type": "speech",
          "speaker": "narrator",
          "content": {
            "korean": "여전히 남아있는 오팔빛 잔향이 그들을 혼란스럽게 했다."
          }
        }
      ]
    },
    {
      "id": 9,
      "dialogue": [
        {
          "spot": [
            5,
            1
          ],
          "duration_ms": 500,
          "action": "enter",
          "speaker": "lin",
          "type": "direction"
        },
        {
          "speaker": "lin",
          "content": {
            "korean": "우리들의 기억은 이어져야 해. 그래야 진정한 나를 찾을 수 있어."
          },
          "emotion": "happy",
          "type": "speech"
        },
        {
          "speaker": "character_any",
          "content": {
            "korean": "우리가 해야 할 일은 실을 엮어내는 것이었어. 처음부터!"
          },
          "emotion": "happy",
          "type": "speech"
        },
        {
          "type": "speech",
          "speaker": "narrator",
          "content": {
            "korean": "오팔빛 잔향이 마지막 저항처럼 더욱 강렬하게 휘몰아쳤다."
          }
        },
        {
          "speaker": "random_boss",
          "content": {
            "korean": "멈춰라! 이 단절만이 너희를 구원할 수 있다!"
          },
          "type": "speech",
          "emotion": "angry"
        },
        {
          "speaker": "character_any",
          "content": {
            "korean": "우리는 더 이상 속지 않아! 우리의 기억을 되찾을 거야!"
          },
          "type": "speech",
          "emotion": "angry"
        }
      ]
    },
    {
      "win_dialogue": [
        {
          "speaker": "narrator",
          "content": {
            "korean": "주인공이 오팔빛 실을 엮어내자, 메멘토의 몸을 감싸던 실들이 빛나기 시작했다."
          },
          "type": "speech"
        },
        {
          "duration_ms": 800,
          "speaker": "boss",
          "action": "exit",
          "type": "direction"
        },
        {
          "emotion": "sad",
          "type": "speech",
          "speaker": "boss",
          "content": {
            "korean": "결국, 내가 틀렸군... 이 모든 단절이 다시 이어지다니..."
          }
        },
        {
          "speaker": "narrator",
          "content": {
            "korean": "메멘토는 빛과 함께 사라지고, 주변에 흩어졌던 기억들이 돌아왔다."
          },
          "type": "speech"
        },
        {
          "speaker": "bex",
          "spot": [
            3,
            1
          ],
          "action": "enter",
          "type": "direction",
          "duration_ms": 500
        },
        {
          "speaker": "bex",
          "content": {
            "korean": "해냈어! 기억이 돌아오고 있어!"
          },
          "emotion": "happy",
          "type": "speech"
        },
        {
          "action": "enter",
          "duration_ms": 500,
          "spot": [
            7,
            1
          ],
          "type": "direction",
          "speaker": "echo"
        },
        {
          "speaker": "echo",
          "content": {
            "korean": "끊어졌던 모든 연결이, 다시 이어지는군!"
          },
          "emotion": "happy",
          "type": "speech"
        },
        {
          "speaker": "character_any",
          "content": {
            "korean": "이제 모든 것이 제자리로 돌아왔어!"
          },
          "emotion": "happy",
          "type": "speech"
        }
      ],
      "dialogue": [
        {
          "type": "speech",
          "speaker": "narrator",
          "content": {
            "korean": "네온 골목길 중앙 무대, 마침내 메멘토가 그 모습을 드러냈다."
          }
        },
        {
          "type": "speech",
          "speaker": "narrator",
          "content": {
            "korean": "그의 몸을 감싼 오팔빛 실들은 슬픔의 조각상처럼 빛나고 있었다."
          }
        },
        {
          "type": "speech",
          "emotion": "base",
          "speaker": "boss",
          "content": {
            "korean": "결국 이곳까지 왔군... 모든 고통을 끝내기 위해선 단절이 필요하다."
          }
        },
        {
          "duration_ms": 500,
          "type": "direction",
          "speaker": "bex",
          "spot": [
            3,
            1
          ],
          "action": "enter"
        },
        {
          "emotion": "angry",
          "speaker": "bex",
          "content": {
            "korean": "아니! 그건 거짓된 평화야! 실을 엮어내야 해!"
          },
          "type": "speech"
        },
        {
          "duration_ms": 500,
          "action": "enter",
          "speaker": "echo",
          "type": "direction",
          "spot": [
            7,
            1
          ]
        },
        {
          "speaker": "echo",
          "content": {
            "korean": "메멘토를 막고, 기억을 되돌려야 해!"
          },
          "emotion": "angry",
          "type": "speech"
        },
        {
          "duration_ms": 500,
          "speaker": "lin",
          "type": "direction",
          "action": "enter",
          "spot": [
            5,
            1
          ]
        },
        {
          "emotion": "angry",
          "type": "speech",
          "speaker": "lin",
          "content": {
            "korean": "우리들의 소중한 연결을 다시 이어야만 해!"
          }
        },
        {
          "speaker": "character_any",
          "content": {
            "korean": "모든 것을 바로잡을 시간이다!"
          },
          "emotion": "happy",
          "type": "speech"
        },
        {
          "speaker": "boss",
          "content": {
            "korean": "어리석군... 내가 너희를 막아주지!"
          },
          "emotion": "angry",
          "type": "speech"
        }
      ],
      "lose_dialogue": [
        {
          "type": "speech",
          "speaker": "narrator",
          "content": {
            "korean": "오팔빛 실은 엮이지 못하고, 네온 골목길의 빛은 영원히 스러졌다."
          }
        },
        {
          "speaker": "boss",
          "content": {
            "korean": "단절된 고통 속에서, 영원한 평화를 얻을 것이다."
          },
          "type": "speech",
          "emotion": "base"
        },
        {
          "type": "speech",
          "speaker": "character_any",
          "content": {
            "korean": "결국... 모든 것이 끝나버렸어."
          },
          "emotion": "sad"
        }
      ],
      "id": 15
    }
  ],
  "prologue": {
    "korean": [
      "네온 골목길은 기억의 흔적이 사라진 공간처럼 변해갔다.",
      "오팔빛 실은 끊어져 나뒹굴었고, 연결은 점점 희미해졌다.",
      "중앙 무대는 잊힌 꿈처럼 정적에 잠겨, 마지막 단절을 기다리고 있었다."
    ]
  },
  "epilogue": {
    "korean": [
      "네온 골목길 중앙 무대는 다시 밝게 빛났다.",
      "오팔빛 실들이 이어지며 사람들의 얼굴에 웃음꽃이 피어났다.",
      "단절된 기억들은 제자리를 찾았고, 도시는 새로운 연결로 숨 쉬었다."
    ]
  }
}