	],
	"dialogue": [
		{
			"speaker": "narrator",
			"content": {
				"korean": "폐기장 천장, 센서 기술자가 오작동 감시 카메라 앞에서 애를 먹고 있었다."
			}
		},
		{
			"speaker": "narrator",
			"content": {
				"korean": "화면은 온통 지직거리는 노이즈뿐이었다."
			}
		},
		{
			"speaker": "sensor_tech",
			"content": {
				"korean": "제길, 카메라가 먹통이야! 이대로 두면 중요한 구역이 감시되지 않아! 좀 도와줘!"
			}
		},
		{
			"speaker": "echo",
			"content": {
				"korean": "이런 혼란스러운 시기에 감시 시스템이 고장 나다니... 왠지 불길해."
			}
		}
	],
	"choices": [
		{
			"text": {
				"korean": "센서 기술자의 수리를 돕고 감시 시스템 복구에 협력한다."
			},
			"mbti": "EF",
			"effects": {
				"community": 30,
				"echo": 5
			},
			"event": "minigame_cup",
			"seed": null,
			"result": [
				{
					"speaker": "sensor_tech",
					"content": {
						"korean": "당신 덕분에 시야가 확보됐어! 고마워, 정말!"
					}
				},
				{
					"speaker": "echo",
					"content": {
						"korean": "감시망이 복구되면 우리의 움직임도 노출될 수 있어."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "기술자는 내 도움으로 카메라를 복구했고, 화면은 다시 정상으로 돌아왔다."
					}
				}
			],
			"event_intro": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "기술자가 건넨 컵 세 개 중 하나에 카메라 제어 칩이 있었다. 정확히 골라야 했다."
					}
				}
			]
		},
		{
			"text": {
				"korean": "감시 시스템 복구가 오히려 '위스퍼 웹'에게 유리할 수 있다며 중단을 요구한다."
			},
			"mbti": "IT",
			"effects": {
				"community": -20,
				"echo": -10
			},
			"reward": [
				"intelligence_down"
			],
			"seed": null,
			"result": [
				{
					"speaker": "sensor_tech",
					"content": {
						"korean": "무슨 소리야! 지금 안 고치면 더 위험해진다고!"
					}
				},
				{
					"speaker": "echo",
					"content": {
						"korean": "맞아, 감시 시스템이 '위스퍼 웹'의 눈이 될 수도 있어."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "기술자는 내 말에 반발했지만, 나는 감시 시스템 복구의 위험성을 강조했다."
					}
				}
			]
		},
		{
			"text": {
				"korean": "센서 기술자를 위협하여 감시 시스템의 제어권을 넘겨받는다."
			},
			"mbti": "ES",
			"require": {
				"stat": "fighting",
				"op": "<=",
				"value": -40
			},
			"effects": {
				"fighting": -10,
				"echo": -5
			},
			"reward": [
				"stun"
			],
			"seed": null,
			"result": [
				{
					"speaker": "sensor_tech",
					"content": {
						"korean": "히익! 알았어! 제어권을 넘겨줄게!"
					}
				},
				{
					"speaker": "echo",
					"content": {
						"korean": "강제로 제어권을 뺏었지만, 지금은 이게 최선일 거야."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "기술자는 겁에 질린 표정으로 감시 시스템 제어권을 나에게 넘겼다."
					}
				}
			]
		}
	]
