	"dialogue": [
		{
			"speaker": "narrator",
			"content": {
				"korean": "네온 간판이 '합치라'는 메시지를 쏟는 순간, 심층부 스크린이 통제 불능으로 폭주하기 시작했다."
			}
		},
		{
			"speaker": "desperate_resident",
			"content": {
				"korean": "안 돼! 제발 멈춰! 이 모든 정보가 뒤섞이면 우리는 끝장이라고!"
			}
		},
		{
			"speaker": "echo",
			"content": {
				"korean": "이대로 뒀다가는 모든 게 빨려 들어갈 거야! 뭐라도 해야 해!"
			}
		}
	],
	"choices": [
		{
			"text": {
				"korean": "폭주하는 스크린 사이를 피해 안전한 곳으로 몸을 숨긴다."
			},
			"mbti": "IS",
			"effects": {
				"community": -30,
