	"dialogue": [
		{
			"speaker": "narrator",
			"content": {
				"korean": "네온 간판이 '통합만이 진리'라 흔들리는 폐기장 안쪽. 정보 광부가 폐기 스크린의 광채를 몰래 탐냈다."
			}
		},
		{
			"speaker": "data_miner",
			"content": {
				"korean": "쉬이잇... 이거 아주 희귀한 거야. '위스퍼 웹'의 힘이 담겨 있다고."
			}
		},
		{
			"speaker": "echo",
			"content": {
				"korean": "저런 위험한 걸 왜 탐내? 분명 더 큰 혼란을 일으킬 거야!"
			}
		}
	],
	"choices": [
		{
			"text": {
				"korean": "정보 광부가 광채 나는 스크린을 수집하도록 내버려 둔다."
			},
			"mbti": "SP",
			"effects": {
				"reason": -30,
				"echo": -5
			},
			"event": "meet_stranger",
			"seed": null,
			"result": [
				{
					"speaker": "data_miner",
					"content": {
						"korean": "굿! 역시 보는 눈이 있는 사람이군. 고맙다고!"
					}
				},
				{
					"speaker": "echo",
					"content": {
						"korean": "저걸 그냥 뒀다가는 어떤 일이 벌어질지 몰라. 불안해."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "정보 광부는 만족스럽게 스크린 조각을 챙겨 어둠 속으로 사라졌다."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "다른 낯선 이가 불쑥 나타나 광채 나는 스크린을 보며 눈을 반짝였다. 그도 이 정보를 노리고 있는 듯했다."
					}
				}
			],
			"event_intro": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "그 순간, 낯선 정보 상인이 다가와 조용히 속삭였다. '돈만 된다면 뭐든지 가능해요.'"
					}
				}
			]
		},
		{
			"text": {
				"korean": "정보 광부를 저지하고, 광채 나는 스크린의 위험성을 경고한다."
			},
			"mbti": "NJ",
			"effects": {
				"reason": 20,
				"echo": 10
			},
			"reward": [
				"move_range_up"
			],
			"seed": null,
			"result": [
				{
					"speaker": "data_miner",
					"content": {
						"korean": "뭐야! 남의 사업 방해하지 마! 내버려 두라고!"
					}
				},
				{
					"speaker": "echo",
					"content": {
						"korean": "위험한 건 함부로 건드려선 안 돼. 잘 막았어!"
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "정보 광부는 잔뜩 화를 내며 물러섰다. 스크린은 여전히 은은하게 빛나고 있었다."
					}
				}
			]
		},
		{
			"text": {
				"korean": "정보 광부에게 돈을 주고 광채 나는 스크린을 포기하게 만든다."
			},
			"mbti": "EN",
			"require": {
				"stat": "gold",
				"op": ">=",
				"value": 150
			},
			"effects": {
				"gold": -150,
				"echo": 5
			},
			"reward": [
				"cooldown_reset"
			],
			"seed": null,
			"result": [
				{
					"speaker": "data_miner",
					"content": {
						"korean": "돈이 최고지! 좋아, 이건 당신 거야."
					}
				},
				{
					"speaker": "echo",
					"content": {
						"korean": "결국 돈으로 해결했지만, 적어도 더 큰 문제가 생기지는 않을 거야."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "정보 광부는 돈을 받고 스크린을 넘겨준 뒤 황급히 사라졌다."
					}
				}
			]
		}
	]
