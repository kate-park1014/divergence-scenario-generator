			}
		},
		{
			"speaker": "echo",
			"content": {
				"korean": "저런 정보로 이득을 취하려 하다니! 역겨워!"
			}
		}
	],
	"choices": [
		{
			"text": {
				"korean": "정보 행상인과 거래하여 다른 이들의 개인 정보를 흘린다."
			},
			"mbti": "IF",
			"effects": {
