	"dialogue": [
		{
			"speaker": "narrator",
			"content": {
				"korean": "폐기장 한쪽 벽에 붙어 있는 오래된 캐비닛. 청소원이 그 앞에서 끙끙대고 있었다."
			}
		},
		{
			"speaker": "cleaner",
			"content": {
				"korean": "아, 이런! 잠금장치가 고장 났네! 안에 중요한 서류가 있는데, 이거 좀 열어줄 수 있어?"
			}
		},
		{
			"speaker": "echo",
			"content": {
				"korean": "이상하다. 왜 이런 곳에 캐비닛이 잠겨 있지?"
			}
		}
	],
	"choices": [
		{
			"text": {
				"korean": "청소원의 요청대로 캐비닛을 조심스럽게 열어준다."
			},
			"mbti": "FP",
			"effects": {
				"reason": 20,
				"gold": 50
			},
			"event": "minigame_cup",
			"seed": null,
			"result": [
				{
					"speaker": "cleaner",
					"content": {
						"korean": "고마워! 덕분에 한시름 놓겠네. 자, 이거라도 받아."
					}
				},
				{
					"speaker": "echo",
					"content": {
						"korean": "쉽게 해결했지만, 뭔가 찝찝한데."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "캐비닛이 '딸깍' 소리와 함께 열렸다. 청소원이 내게 작은 봉투를 건넸다."
					}
				}
			],
			"event_intro": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "열린 캐비닛 안에서 컵 세 개가 흔들리고 있었다. 그 중 하나에만 중요한 정보가 담겨 있는 듯했다."
					}
				}
			]
		},
		{
			"text": {
				"korean": "캐비닛이 잠긴 이유를 먼저 파악하고, 열지 말 것을 권유한다."
			},
			"mbti": "TJ",
			"effects": {
				"reason": -10,
				"echo": 5
			},
			"reward": [
				"intelligence_up"
			],
			"seed": null,
			"result": [
				{
					"speaker": "cleaner",
					"content": {
						"korean": "그러다 일이 더 늦어지면 어쩌려고! 빨리 열어야 한다고!"
					}
				},
				{
					"speaker": "echo",
					"content": {
						"korean": "그래, 무작정 열면 안 돼. 신중해야 해."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "청소원은 안달했지만, 나는 캐비닛 주변을 살폈다."
					}
				}
			]
		},
		{
			"text": {
				"korean": "캐비닛 잠금 장치 해독을 위해 복잡한 절차를 거쳐 안전하게 연다."
			},
			"mbti": "EN",
			"require": {
				"stat": "reason",
				"op": ">=",
				"value": 40
			},
			"effects": {
				"reason": 10,
				"echo": 5
			},
			"reward": [
				"cooldown_reset"
			],
			"seed": null,
			"result": [
				{
					"speaker": "cleaner",
					"content": {
						"korean": "와... 이런 기술도 있었네. 덕분에 살았어!"
					}
				},
				{
					"speaker": "echo",
					"content": {
						"korean": "완벽하게 안전하게 처리했어. 역시 네 실력은 대단하다."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "복잡한 과정을 거쳐 캐비닛이 아무 소리 없이 열렸다."
					}
				}
			]
		}
