{
	"cards": [
		{
			"id": "card_05_locked_cabinet",
			"background_tags": [
				"industrial shelves",
				"dusty metal",
				"flickering light",
				"cluttered alley",
				"forgotten tools"
			],
			"dialogue": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "스크린 섬광이 희미하게 비치는 구석, 폐기장 청소원이 잠긴 캐비닛 앞에서 쩔쩔매고 있었다."
