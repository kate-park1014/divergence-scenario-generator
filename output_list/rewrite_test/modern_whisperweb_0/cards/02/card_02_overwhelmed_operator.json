	"dialogue": [
		{
			"speaker": "narrator",
			"content": {
				"korean": "당신이 스크린을 합치자 주변 센서들이 요동쳤다."
			}
		},
		{
			"speaker": "narrator",
			"content": {
				"korean": "센서 담당자가 단말기 앞에서 비명을 질렀다."
			}
		},
		{
			"speaker": "sensor_operator",
			"content": {
				"korean": "안 돼! 센서들이 미쳤어! 모든 신호가 뒤죽박죽이야!"
			}
		},
		{
			"speaker": "sensor_operator",
			"content": {
				"korean": "시스템이 과부하됐다고!"
			}
		},
		{
			"speaker": "dax",
			"content": {
				"korean": "정보 유출 신호가 너무 강해서"
			}
		},
		{
			"speaker": "dax",
			"content": {
				"korean": "센서 담당자가 혼란에 빠진 것 같아."
			}
		}
	],
	"choices": [
		{
			"text": {
				"korean": "센서 담당자의 혼란을 방관하며 자신만의 분석에 집중한다."
