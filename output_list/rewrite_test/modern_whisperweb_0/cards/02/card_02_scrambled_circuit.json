		},
		{
			"speaker": "dax",
			"content": {
				"korean": "저 사람, 지금 방해만 하고 있습니다. 저러다간 더 큰 문제를 일으킬 것 같습니다."
			}
		}
	],
	"choices": [
		{
			"text": {
