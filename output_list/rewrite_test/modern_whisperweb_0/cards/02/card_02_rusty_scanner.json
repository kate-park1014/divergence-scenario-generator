			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "당신은 먼지 쌓인 폐기장 구석을 뒤졌다."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "닥스는 초조하게 당신을 기다렸다."
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "시간이 없는데… 너무 돌아가는 방법 아니겠어?"
					}
				}
			]
		},
		{
			"text": {
				"korean": "상인에게 웃돈을 주고 즉시 부품을 구매하여 시간을 단축한다."
			},
			"mbti": "IN",
			"require": {
