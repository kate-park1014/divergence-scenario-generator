	"dialogue": [
		{
			"speaker": "narrator",
			"content": {
				"korean": "닥스가 스크린 분석 장비를 점검하다 멈췄다. 핵심 부품이 없었다."
			}
		},
		{
			"speaker": "narrator",
			"content": {
				"korean": "그때, 지역 사업가가 녹슨 스캐너 부품을 들고 다가왔다."
			}
		},
		{
			"speaker": "dax",
			"content": {
				"korean": "이런, 스캐너 부품이 하나 빠졌지 않습니까! 저기, 주인장!"
			}
		},
		{
			"speaker": "local_entrepreneur",
			"content": {
				"korean": "이거 말입니까? 딱 봐도 좋은 부품인데… 살 거면 돈 내세요!"
			}
		}
	],
	"choices": [
		{
			"text": {
				"korean": "상인에게 부품을 빌려달라고 설득하여 잠시 사용권을 얻는다."
			},
			"mbti": "EN",
			"effects": {
				"fighting": 20,
				"echo": 5,
				"gold": 50
			},
			"event": "minigame_cup",
			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "당신은 상인을 설득해 부품을 잠시 빌리기로 했다. 닥스가 서둘러 장착했다."
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "간신히 빌렸네요. 아무래도 눈치를 보며 사용해야 할 것 같습니다."
					}
				}
			],
			"event_intro": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "상인은 당신에게 컵 세 개를 보여주며 부품이 든 컵을 맞히면 빌려주겠다고 했다."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "그의 손놀림은 빨랐다."
					}
				}
			]
		},
		{
			"text": {
				"korean": "직접 폐기장을 뒤져 상인이 가진 것과 비슷한 부품을 찾는다."
			},
			"mbti": "IS",
			"effects": {
