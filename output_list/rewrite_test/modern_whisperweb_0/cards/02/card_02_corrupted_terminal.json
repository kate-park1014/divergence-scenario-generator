			],
			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "당신은 단말기를 외면하고 통제 구역으로 발걸음을 재촉했다."
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "저 단말기를 그냥 지나치다니요. 나중에 후회할 수도 있습니다."
					}
				}
			]
		},
		{
			"text": {
				"korean": "단말기의 전원을 찾아 꺼서 혼란을 막는다."
