		},
		{
			"speaker": "narrator",
			"content": {
				"korean": "정보 수집가가 나타나 그 정보를 독점하려다 당신과 충돌했다."
			}
		},
		{
			"speaker": "info_collector",
			"content": {
				"korean": "이건 다 내 거라고! 아무도 이 정보에 손대지 마!"
			}
		},
		{
			"speaker": "dax",
			"content": {
				"korean": "{random_boss}의 시선이 잠시 흐트러졌습니다."
			}
		},
		{
			"speaker": "dax",
			"content": {
				"korean": "저 단말기, 뭔가 흥미로운 정보가 흘러나오는 것 같습니다."
			}
		}
	],
	"choices": [
		{
			"text": {
				"korean": "오염된 단말기를 외면하고 통제 구역으로 돌진한다."
