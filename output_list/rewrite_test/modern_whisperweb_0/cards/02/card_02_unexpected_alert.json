	"dialogue": [
		{
			"speaker": "narrator",
			"content": {
				"korean": "스크린 합치기 작업이 진행되던 중, 폐기장의 낡은 보안 시스템이 오작동했다."
			}
		},
		{
			"speaker": "narrator",
			"content": {
				"korean": "요란한 경보음이 울려 퍼졌고, 보안 담당자가 당신을 경계하며 통행을 막으려 했다."
			}
		},
		{
			"speaker": "security_officer",
			"content": {
				"korean": "경보가 울렸습니다! 여기서 뭘 하는 겁니까! 당장 움직임을 멈추십시오!"
			}
		},
		{
			"speaker": "dax",
			"content": {
				"korean": "큰일입니다! 경보가 울려 모두의 시선이 우리에게 집중됐습니다."
			}
		}
	],
	"choices": [
		{
			"text": {
				"korean": "경보음을 무시하고 작업을 서두른다."
			},
			"mbti": "ST",
			"effects": {
				"fighting": -30,
				"echo": -10
