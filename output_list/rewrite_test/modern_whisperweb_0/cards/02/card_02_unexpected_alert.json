			"event": "minigame_cup",
			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "당신은 경보음을 무시하고 스크린 합치기 작업을 서둘렀다."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "보안 담당자는 더욱 격앙되어 당신을 막아섰다."
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "계속 무시하다간 저 담당자가 더 많은 사람들을 불러올지도 모릅니다."
					}
				}
			],
			"event_intro": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "경보음이 규칙적으로 울리며, 폐기장 전체에 긴장감이 감돌았다."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "당신은 위험을 감수하고 빠르게 움직여야 했다."
					}
				}
			]
		},
		{
			"text": {
				"korean": "경보 시스템의 전원을 찾아 차단하여 소음을 멈춘다."
			},
			"mbti": "NT",
			"effects": {
