	"dialogue": [
		{
			"speaker": "narrator",
			"content": {
				"korean": "폐기장 한구석, 소문 상인이 은밀히 사람들을 불러 모았다."
			}
		},
		{
			"speaker": "narrator",
			"content": {
				"korean": "그는 작은 스크린을 내보이며 은행 계좌 오류나 청구서 혼동 같은 기묘한 소문들을 속삭였다."
			}
		},
		{
			"speaker": "rumor_vendor",
			"content": {
				"korean": "다들 들었소? 은행 계좌가 뒤죽박죽이라던데, 이런 일은 처음이오!"
			}
		},
		{
			"speaker": "dax",
			"content": {
				"korean": "개인 재정 정보 유출 소문이라… 그게 사실이라면 심각합니다."
			}
		}
	],
	"choices": [
		{
			"text": {
				"korean": "소문 상인의 말을 믿고 정보를 더 많은 사람들에게 퍼뜨린다."
			},
			"mbti": "SP",
			"effects": {
				"reason": -20,
				"echo": -5,
				"gold": 80
			},
			"event": "minigame_slot",
			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "당신은 소문 상인의 말에 귀 기울였고, 그 정보를 주변에 더 퍼뜨렸다."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "사람들은 더욱 혼란스러워하며 술렁였다."
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "진위도 확인 안 된 정보를 퍼뜨리시다니… 상황을 악화시킬 수 있습니다."
					}
				}
			],
			"event_intro": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "소문 상인이 손에 들고 있던 낡은 단말기 화면이 불규칙하게 깜빡였다."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "어떤 정보가 나타날지는 아무도 알 수 없었다."
					}
				}
			]
		},
		{
			"text": {
				"korean": "소문 상인의 말을 의심하고 직접 소문의 진위를 확인하려 한다."
			},
			"mbti": "NT",
			"effects": {
				"reason": 20,
				"echo": 10
			},
			"reward": [
				"intelligence_up"
			],
			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "당신은 소문의 진위를 확인하려 했다. 상인은 잠시 당황하는 듯했다."
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "역시 신중한 접근이 필요합니다. 섣부른 판단은 독이 될 수 있습니다."
					}
				}
			]
		},
		{
			"text": {
				"korean": "소문 상인에게 소문의 출처와 근거를 강하게 추궁하며 사실 확인을 요구한다."
			},
			"mbti": "ET",
			"require": {
				"stat": "fighting",
				"op": ">=",
				"value": 40
			},
			"effects": {
				"fighting": -10,
				"echo": -5
			},
			"reward": [
				"attack_up"
			],
			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "당신은 소문 상인에게 소문의 출처를 강하게 추궁했다."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "그는 얼버무리며 황급히 자리를 피했다."
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "굳이 그렇게까지 몰아붙이실 필요는 없었을 텐데요. 중요한 정보는 없지 않습니까?"
					}
				}
			]
		}
	]
