	"dialogue": [
		{
			"speaker": "narrator",
			"content": {
				"korean": "{random_boss}과의 대치 상황이 이어지는 가운데, 데이터 청소부가 나타났다."
			}
		},
		{
			"speaker": "narrator",
			"content": {
				"korean": "그는 정보 유출로 더 혼란스러워진 폐기장을 '정리'하려다 중요한 통로를 막아버렸다."
			}
		},
		{
			"speaker": "data_cleaner",
			"content": {
				"korean": "다 치워야 해! 다 정리해야 한다고! 이거 전부 쓰레기야!"
			}
		},
		{
			"speaker": "dax",
			"content": {
				"korean": "저 사람… 또 나타나서 방해하는군요. {random_boss}도 이런 상황에 당황한 것 같습니다."
			}
		}
	],
	"choices": [
		{
			"text": {
				"korean": "청소부가 쌓아놓은 쓰레기를 치우고 강제로 통로를 확보한다."
			},
			"mbti": "ET",
			"effects": {
				"reason": -20,
				"echo": -10
			},
			"reward": [
				"hp_down"
			],
			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "당신은 청소부가 쌓아놓은 쓰레기를 힘으로 치웠다. 통로가 겨우 확보됐다."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "청소부는 당신을 원망스러운 눈으로 바라봤다."
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "길은 뚫었지만, 불필요한 적을 만든 것 같아 마음이 좋지 않습니다."
					}
				}
			]
		},
		{
			"text": {
				"korean": "청소부의 작업을 돕는 척하며, 통로를 안전하게 확보할 방법을 찾는다."
			},
			"mbti": "NF",
			"effects": {
				"community": 20,
				"echo": 10
			},
			"event": "meet_stranger",
			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "당신은 청소부를 돕는 척하며, 그가 통로를 열도록 유도했다."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "그는 순진하게 당신이 시키는 대로 움직였다."
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "역시 당신은 영리하십니다. 불필요한 충돌 없이 목적을 달성했군요."
					}
				}
			],
			"event_intro": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "청소부는 주변을 '정리'하며 계속 중얼거렸다."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "그의 중얼거림 속에서 작은 단서가 들려오는 듯했다."
					}
				}
			]
		}
	]
