			"reward": [
				"hp_down"
			],
			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "당신은 쓰레기를 거칠게 치웠다. 청소부는 놀라 비명을 질렀고,"
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "{random_boss}은(는) 이 모든 소란에 더욱 경계했다."
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "으음, 상황을 더 복잡하게 만드는 것 같기도 하고…"
					}
				}
			]
		},
		{
			"text": {
				"korean": "청소부의 작업을 돕는 척하며, 통로를 안전하게 확보할 방법을 찾는다."
			},
			"mbti": "NF",
			"effects": {
				"community": 20,
				"echo": 10
			},
			"event": "meet_stranger",
			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "당신은 청소부를 돕는 척하며 자연스럽게 통로를 확보했다."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "청소부는 당신에게 연신 고마워했다."
					}
				},
				{
					"speaker": "dax",
					"content": {
						"korean": "역시 당신은 영리해. 불필요한 충돌 없이 목적을 달성했군."
					}
				}
			],
			"event_intro": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "청소부 옆에 있던 낡은 스크린에서 작은 인형 하나가 튀어나왔다."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "'정리… 필요해…?'"
					}
				}
			]
		}
