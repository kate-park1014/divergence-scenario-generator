			],
			"event_intro": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "잠시 쉴 곳을 찾았다. 주변 폐기물에서 알 수 없는 소리가 들려왔다."
					}
				}
			]
		},
		{
			"text": {
