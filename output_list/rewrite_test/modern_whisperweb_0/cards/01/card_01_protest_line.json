			],
			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "돈을 받은 시위대는 잠시 망설이다가 길을 열어주었다. 그들의 표정은 굳어 있었다."
					}
				},
				{
					"speaker": "echo",
					"content": {
						"korean": "돈으로 해결하는 건 영 개운치 않지만… 어쨌든 통과했어."
					}
				}
			]
		}
	]
