	"dialogue": [
		{
			"speaker": "narrator",
			"content": {
				"korean": "폐기장 입구에 운동가 박을 비롯한 시위대가 모여들어 진입을 막아서고 있었다."
			}
		},
		{
			"speaker": "protestor",
			"content": {
				"korean": "폐기장의 진실을 밝혀라! 우리를 기만하지 마라!"
			}
		},
		{
			"speaker": "echo",
			"content": {
				"korean": "상황이 심각한데. 저들을 지나가려면 뭔가 해야 할 것 같아."
			}
		}
	],
	"choices": [
		{
			"text": {
				"korean": "시위대를 피해 옆쪽의 좁은 틈새로 몰래 이동한다"
			},
			"mbti": "IS",
			"effects": {
				"fighting": -30,
