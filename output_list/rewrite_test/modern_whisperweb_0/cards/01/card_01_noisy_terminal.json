	"dialogue": [
		{
			"speaker": "narrator",
			"content": {
				"korean": "폐기장 입구 통로에 고물 수리공 칼이 앉아 잡음 심한 단말기를 수리하고 있었다."
			}
		},
		{
			"speaker": "narrator",
			"content": {
				"korean": "단말기에서 나는 '지직'거리는 소리가 통로를 가득 채웠다."
			}
		},
		{
			"speaker": "repair_tech",
			"content": {
				"korean": "이놈의 단말기는 왜 이리 잡음이 심한지… 중요한 정보가 끊기잖아!"
			}
		},
		{
			"speaker": "echo",
			"content": {
				"korean": "이 소리, 어쩐지 아까 그 스크린 소리랑 비슷해요. 점점 심해지는 것 같지 않아요?"
			}
		}
	],
	"choices": [
		{
			"text": {
				"korean": "수리공 칼의 작업을 도와주며 단말기의 정보를 엿본다"
			},
			"mbti": "ET",
			"effects": {
				"fighting": 20,
				"echo": 5
			},
			"reward": [
				"intelligence_up"
			],
			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "수리공은 당신의 도움에 감사하며 단말기 내부 정보를 잠시 보여주었다. 혼란스러운 데이터였다."
					}
				},
				{
					"speaker": "repair_tech",
					"content": {
						"korean": "오, 제법인데? 고마워!"
					}
				},
				{
					"speaker": "echo",
					"content": {
						"korean": "데이터에서 뭔가 알아낼 수 있을지도 몰라요!"
					}
				}
			]
		},
		{
			"text": {
				"korean": "수리공의 작업을 방해하지 않고 조용히 기다린다"
