	"dialogue": [
		{
			"speaker": "pipe_bruiser",
			"content": {
				"korean": "당신이죠? 지난번에 통로 막은 놈들 멱살 잡고 밀어낸 사람."
			}
		},
		{
			"speaker": "narrator",
			"content": {
