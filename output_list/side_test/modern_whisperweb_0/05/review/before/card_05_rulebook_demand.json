			],
			"seed": null,
			"result": [
				{
					"speaker": "procedure_inspector",
					"content": {
						"korean": "보류 요청이라면 접수는 되는데, 당신 이름이면 처리가 빠를 거예요."
					}
				},
				{
					"speaker": "narrator",
					"content": {
						"korean": "감독관이 서류 뭉치를 품에 안고 책상 쪽으로 물러났다."
					}
				},
				{
					"speaker": "echo",
					"content": {
						"korean": "이름 하나로 서류가 멈췄어. 이게 다 규칙대로 쌓아 온 거지."
					}
				}
			]
		},
		{
			"text": {
				"korean": "감독관의 서류 여섯 장을 모두 펼쳐 벽에 나란히 붙인다."
			},
			"path": "fun",
			"mbti": "NP",
			"effects": {
				"reason": -25,
				"community": 10
			},
			"reward": [
				"move_range_up"
			],
			"seed": null,
			"result": [
				{
					"speaker": "narrator",
					"content": {
						"korean": "벽에 붙은 여섯 장이 바람에 흔들리며 한 장씩 겹쳐 읽혔다."
					}
				},
				{
					"speaker": "procedure_inspector",
					"content": {
						"korean": "이, 이건 서류 훼손이에요! 그런데… 겹쳐 보니 글자가 하나로 이어지네요."
					}
				},
				{
					"speaker": "echo",
					"content": {
						"korean": "여섯 장을 겹치면 한 문장이 되다니. 이거 누가 만든 서식이야?"
					}
				}
			]
		}
